{ f: 110, l: 1/8, g: 1, p: 0 }

-- Yurakucho neon: 80s Japanese synth pop / city pop, YMO lineage.
-- 120 bpm sixteenths (l: 1/8 → 16 pulses = one 2s bar).
-- A major, just intonation. The classic city-pop turn:
-- IVmaj7 → V7 → iii7 → vi7 (Dmaj7 E7 C#m7 F#m7) as off-beat stabs,
-- root-fifth bounce bass in 8ths, chirpy pentatonic lead doubled and
-- detuned for chorus sparkle. Everything on the kit is TUNED to A:
-- the kick is a dialed partial stack, the clap/snare backbeat sits on
-- the fifth, hats ring on the ninth, and the Simmons-style tom fills
-- step down chord tones (3/2 → 4/3 → 5/4 → 9/8).
--
-- Play: weresocool play yurakucho_neon.socool

x = { Silence 1 }

-- ── the kit, in the key of A ────────────────────────────────────────
bd = {
    Overlay [
        { 1/1, 0, 1, 1/8 },
        { 1/1, -4, 1, -1/8 },
        { 2/1, 0, 1/3, 0 }
    ]
    | Kick {
        body: 0.9,
        pitch_decay: 0.03,
        pitch_range: 0.25,
        amp_decay: 0.35,
        click_amount: 0.35,
        saturation: 0.7,
        hump: 3.2,
        shell: 0.3,
        ks_mix: 0.2
    }
    | Gm 0.9
}

-- backbeat: clap on the fifth, snare ghost on the root octave
cpx = {
    Overlay [
        Clap 909 | Fm 3/2 | Gm 0.55,
        Snare 909 | Fm 1 | Gm 0.3
    ]
}

hh = { HiHat 909 | Fm 9/8 | Gm 0.14 | Pa 1/4 }
ha = { HiHat 909 | Fm 9/8 | Gm 0.28 | Pa 1/4 }
oh = { OpenHat 909 | Fm 9/8 | Gm 0.3 | Pa 1/4 }

-- Simmons syn-tom: tuned to chord tones via Fm at the call site
tm = { Tom 808 | Tanh(2, 0.8) | Gm 0.65 | Pa -1/4 }

-- ── drum patterns ───────────────────────────────────────────────────
kick4 = { Seq [bd, x, x, x] | Repeat 4 }

claps = { Seq [x | Lm 4, cpx | Lm 4, x | Lm 4, cpx | Lm 4] }

hats_a = { Seq [ha, hh, hh, hh] | Repeat 4 }
hats_b = {
    Seq [
        ha, hh, hh, hh,   ha, hh, hh, hh,
        ha, hh, hh, hh,   ha, hh, oh | Lm 2
    ]
}

-- one bar plain, one bar with the open-hat lift
drums2 = {
    Seq [
        Overlay [kick4, claps, hats_a],
        Overlay [kick4, claps, hats_b]
    ]
}

-- the 80s tuned tom fill: last beat of the 2-bar phrase, walking down
fill = {
    Seq [
        x | Lm 24,
        tm | Fm 3/2 | Lm 2,
        tm | Fm 4/3 | Lm 2,
        tm | Fm 5/4 | Lm 2,
        tm | Fm 9/8 | Lm 2
    ]
}

drumsfill = { Overlay [drums2, fill] }

-- ── bass: root-fifth bounce, 8ths (2 bars) ──────────────────────────
bass2 = {
    Overlay [
        { 1/1, 0, 1, 0 },
        { 2/1, 0, 1/4, 0 },
        { 3/1, 0, 1/10, 0 }
    ]
    | Tanh(1.5, 0.85)
    | Seq [
        Fm 2/3 | Lm 2, Fm 2/3 | Lm 1, Fm 4/3 | Lm 1, Fm 2/3 | Lm 2, Fm 4/3 | Lm 2,
        Fm 3/4 | Lm 2, Fm 3/4 | Lm 1, Fm 3/2 | Lm 1, Fm 3/4 | Lm 2, Fm 3/2 | Lm 2,
        Fm 5/8 | Lm 2, Fm 5/8 | Lm 1, Fm 5/4 | Lm 1, Fm 5/8 | Lm 2, Fm 5/4 | Lm 2,
        Fm 5/6 | Lm 2, Fm 5/6 | Lm 1, Fm 5/3 | Lm 1, Fm 5/6 | Lm 2, Fm 5/3 | Lm 2
    ]
    | Gm 0.35
}

-- ── the chords: Dmaj7 E7 C#m7 F#m7, detuned pairs for sparkle ───────
dm7 = {
    Overlay [
        { 4/3, 2, 1, 1/2 }, { 4/3, -2, 1, -1/2 },
        { 5/3, 3, 1, -1/3 }, { 2/1, -3, 1, 1/3 },
        { 5/2, 2, 1/2, 0 }
    ] | Gm 0.13
}

e7 = {
    Overlay [
        { 3/2, 2, 1, 1/2 }, { 3/2, -2, 1, -1/2 },
        { 15/8, 3, 1, -1/3 }, { 9/4, -3, 1, 1/3 },
        { 8/3, 2, 1/2, 0 }
    ] | Gm 0.13
}

csm7 = {
    Overlay [
        { 5/4, 2, 1, 1/2 }, { 5/4, -2, 1, -1/2 },
        { 3/2, 3, 1, -1/3 }, { 15/8, -3, 1, 1/3 },
        { 9/4, 2, 1/2, 0 }
    ] | Gm 0.13
}

fsm7 = {
    Overlay [
        { 5/3, 2, 1, 1/2 }, { 5/3, -2, 1, -1/2 },
        { 2/1, 3, 1, -1/3 }, { 5/2, -3, 1, 1/3 },
        { 3/1, 2, 1/2, 0 }
    ] | Gm 0.13
}

-- off-beat stab figure: push, answer, hold (8 pulses per chord)
stab(c) = { Seq [c | Lm 2, x, c | Gm 0.7, x | Lm 2, c | Lm 2] }

prog = { Seq [stab(dm7), stab(e7), stab(csm7), stab(fsm7)] }

-- ── the hook: A major pentatonic, chorus-detuned octave pair ────────
lead = {
    Overlay [
        { 2/1, 3, 1, 1/2 },
        { 2/1, -3, 1, -1/2 },
        { 4/1, 0, 1/5, 0 }
    ]
    | Seq [
        Fm 2 | Lm 2, Fm 5/3, Fm 2, Fm 9/4 | Lm 4,
        Fm 5/2 | Lm 2, Fm 9/4 | Lm 2, Fm 2 | Lm 4,
        Fm 5/3 | Lm 2, Fm 3/2, Fm 5/3, Fm 9/8 | Lm 4,
        Fm 5/4 | Lm 2, Fm 3/2 | Lm 2, Fm 5/3 | Lm 2, Fm 0 | Lm 2
    ]
    | Gm 0.26
}

-- ── turnaround: the full Simmons cascade, one bar ───────────────────
cascade = {
    Seq [
        tm | Fm 5/2 | Lm 2, tm | Fm 9/4 | Lm 2,
        tm | Fm 2 | Lm 2, tm | Fm 5/3 | Lm 2,
        tm | Fm 3/2 | Lm 2, tm | Fm 4/3 | Lm 2,
        tm | Fm 5/4 | Lm 2, tm | Fm 9/8 | Lm 2
    ]
}

turnaround = { Overlay [kick4, claps, cascade] }

-- ── tag: ring out on Amaj9 ──────────────────────────────────────────
amaj9 = {
    Overlay [
        { 1/1, 0, 1, 0 },
        { 5/4, 2, 1, 1/2 }, { 5/4, -2, 1, -1/2 },
        { 3/2, 3, 1, -1/3 }, { 15/8, -3, 1, 1/3 },
        { 9/4, 2, 1/2, 0 }
    ] | Gm 0.2
}

tag = {
    Overlay [
        bd | Lm 16,
        amaj9 | Lm 16,
        Seq [tm | Fm 1 | Lm 16]
    ]
}

-- ── form ────────────────────────────────────────────────────────────
main = {
    Seq [
        Overlay [drums2, bass2],
        Overlay [drumsfill, bass2, prog],
        Overlay [drums2, bass2, prog, lead],
        Overlay [drumsfill, bass2, prog, lead],
        Overlay [drums2, bass2, prog, lead] | Fm 6/5,
        turnaround,
        tag
    ]
}
