hh = {
    HiHat {
        metal: 0.75,
        decay_rate: 20,
        brightness: 0.85,
        pitch_drop: 0.05,
        ping_amount: 0.72
    }
    | Fm 8
    | #hh
}

x = { Gm 0 }

bass_drum = {
    Seq [
        bd, x, bd, x, x, bd,
    ]
    | Repeat 16 | Lm 1/8
    | ModBy [Lm 13, Gm 0]
    | Gm 2
    | FitLength thing2
}

hi_hat = {
    Overlay [
        Seq [
            hh, x, hh, hh, x, hh, hh, x,
        ] | Repeat 12
        | ModBy [Lm 13, Gm 0]
    ]
    | FitLength thing2
}

part2 = {
    Overlay [
        thing2,
        Overlay [
            bass_drum,
            hi_hat
        ] | #drums
    ]
    | Seq [
        Repeat 3,
        Fm 7/6 | Lm 7/6,
        Repeat 3,
        Fm 7/8 | Lm 7/8,
        Fm 0 | Lm 1/100,
    ]
    | Gm 3/2
}

main = {
    Seq [
        part1,
        part2,
        Fm 0 | Lm 1/100,
        thing1
        | Seq [
            Fm 8/5 | Lm 1/8,
            Fm 2 | Lm 1/10,
            Fm 9/8 | Lm 1/7,
            Fm 5/2 | Lm 1/6 | Reverse,
        ]
    ]
    | Gm 1/2
}
