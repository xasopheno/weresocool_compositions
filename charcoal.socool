{ f: 311.127, l: 1, g: 1/3, p: 0 }

thing1 = {
    Overlay [
        { 1/1, 2, 1, 0 },
        { 1/1, 0, 1, 0 },
    ]
    | Overlay [
        Seq [Fm 5, Fm 0, Fm 0] | Lm 1/8,
        Seq [Fm 3, Fm 0, Fm 0] | Lm 1/8,
        Fm 1
    ]
    | Seq [
        Fm 1/2
        | Color [pinkishorange, black, black] | Gradient(0, 1, -1),
        Fm 9/8 | Pa 0.25
        | Color [blue, black, black] | Gradient(0, 1, -1),
        Fm 1/4 | Pa -0.25 | Lm 2 | Color [rosered, black, black ] | Gradient(0, 1, -1)
        | wgsl {
            Sm 1.5;
        },
    ]
    | Repeat 8
    | wgsl {
        Sm 2;
        Ym 4.0;
        Xm 4;
        Rz 0.5;
        Seq [
            Sm 3/2 | Direction (0.2, -1, 0.5);
            Direction (0.2, -1, 0.5);
        ];
    }
    | Overlay [
        Sine,
        Square | Wavefolder(0.8, 8, 1, 0.2),
    ]
    | wgsl {
        Vm 1/2;
        Ya -0.5;
        Sm 2;
        Xm 3;
        Xa "sin(time * 2) * 0.1";
        Za -5;
    }
}

thing2 = {
    Overlay [
        Overlay [
            { 3, 0, 1/4, 0 },
            { 5/2, 0, 1/4, 0 },
            { 1/1, 3, 1, 1 },
            { 1/1, 0, 1, -1 },
        ]
        | Color [vividpurple, grey, black, black] | Gradient(0, 1, 0),
        Overlay [
            { 3/2, 3, 1, 1 },
            { 3/2, 0, 1, -1 },
        ]
        | wgsl {
            x = x * (sin(1 + time * 64));
        }
        | Color [blue, grey, black, black, black] | Gradient(0, 1, 0)
    ]
    | Gm 1/3
    | Seq [
        Fm 3/4 | Lm 6, Fm 1/3 | Lm 2
    ]
    | FitLength thing1
    | Overlay [
        wgsl {
            Ym 2;
            Sm 2.5;
            Seq [
                Direction (-1, 0.3, -1) | Lm 8;
            ];
        },
        wgsl {
            Ym 2;
            Sm 2.5;
            Seq [
                Direction (1, 0.3, -1) | Lm 8;
            ];
        }
    ]
    | wgsl {
        scale = 1 / (1 + time);
    }
}

thing3 = {
    Overlay [
        { 1, 0, 1, 0 },
        { 9/8, 0, 1, 0 },
    ]
    | Gm 1/2
    | ModBy [
        Seq [Fm 1, Fm 0, Fm 1, Fm 1, Fm 0, Fm 1, Fm 0] | Repeat 8
    ]
    | Seq [
        Fm 1, Fm 5/4
    ]
    | wgsl {
        Sm 8;
        Ym 3;
        Ya 1/2;
        Xa 2.5;
        Za -10;
        Seq [
            Direction (1, 0.3, 0) | Bend (-1, 0, 0, 0.5) | Lm 16;
        ];
    }
    | Color [lightpurple, black, black, black, black] | Gradient(-1, 1, -1)
    | FitLength thing1
    | Overlay [
        Sine,
        Sine 3/2 | Gm 1/4
    ]
}

main = {
    Overlay [
        thing1 | #a,
        thing2 | #b,
        -- thing3,
    ]
    | Seq [
        Lm 1/8 | Repeat 16
    ]
} -> [a, b]
