{ f: 311.127, l: 1, g: 1/3, p: 0 }

thing1 = {
    Overlay [
        Overlay [
            {2/3, 0, 1, 0.01},
            {2/3, -3, 1, -0.01},
        ]
        | wgsl {
            Seq [
                Direction(0, -1, 0) 
                | Ya 0.6
                | Lm 6/8;
                Am 0;
            ]
            | Xa 1/2
        } | Repeat 3,

        Overlay [
            {11/4, 0, 1, 0.1},
            {11/4, -4, 1, -0.1},
        ]
        | wgsl {
            Seq [
                Direction(1, 0, 0);
                Am 0;
            ]
        } | Seq [Fm 1, Fm 9/8 | Lm 1/8] | Repeat 5 | Lm 1/2,

        Overlay [
            {9/8, 0, 1, 0},
            {1/1, 2, 1, 0},
        ]
        | Overlay [
            Seq [Fm 1, Fm 0, Fm 9/8, Fm 0] | Repeat 3 | Lm 1/3,
            Seq [Fm 5/6, Fm 0, Fm 15/16, Fm 0] | Repeat 3 | Lm 1/3,
        ]
        | Lm 1/4
        | wgsl {
            Seq [
                Direction(-0.1, -1, 0.1) 
                | Vm 1/8 
                | Lm 1/5;
                Am 0;
            ]
        } | Repeat 3,

        Overlay [
            {15/8, 3, 1, 0},
            {5/3, 2, 1, 0},
        ]
        | Overlay [
            Seq [Fm 1, Fm 1, Fm 9/8, Fm 1, Fm 1] | Repeat 3 | Lm 1/3,
            Seq [Fm 5/6, Fm 1, Fm 15/16, Fm 1] | Repeat 3 | Lm 1/3,
        ]
        | Lm 1/3
        | Seq [AsIs, Reverse]
        | wgsl {
            Seq [
                Direction(1, 0, 0);
                Direction(-0.08, -1, 0) 
                | Ya 0.2
                | Bend (0, -1/8, 0, 1)
                | Lm 1/4;
                Am 0;
            ]
            | Ya -1/5;
        },

        Overlay [
            {5/6, 3, 1, 1/4},
            {5/6, 0, 1, -1/4},
        ]
        | Overlay [
            Seq [Fm 1, Fm 0] | Repeat 2 | Lm 1/2,
        ]
        | Repeat 3
        | Lm 1/3
        | Seq [AsIs, Reverse]
        | wgsl {
            Seq [
                Direction(1, 1, 0)
                | Xa 0.4
                | Lm 1/5;
                Am 0;
            ]
            | Ya -1/5;
        },

        Overlay [
            {1/2, 0, 1, 1/4},
            {1/2, 3, 1, -1/4},
        ]
        | Overlay [
            Seq [Fm 1, Fm 0] | Repeat 3 | Lm 1/3,
        ]
        | Repeat 3
        | Lm 1/3
        | Seq [AsIs, Reverse]
        | wgsl {
            Seq [
                Direction(1, 1, 0)
                | Xa 0.4
                | Lm 1/5;
                Am 0;
            ]
            | Ya -1/5;
        }
    ]
}

thing2 = {
    Overlay [
        Overlay [
            {1, 3, 1, 0},
            {1, 0, 1, 0},
            {1/4, 1, 1, 0},
            {1/4, 0, 1, 0},
        ]
        | Seq [Fm 1, Fm 0, Fm 1, Fm 0, Fm 1, Fm 1] | Seq [Fm 1, Fm 0, Lm 3] | Repeat 3
        | Lm 1/3
        | wgsl {
            Seq [
                Direction(1, 0, 0);
                Am 0;
            ]
            | Ya -5/8;
        }
        | FitLength thing1,

        Overlay [
            {5/6, 0, 1, 0},
        ]
        | Lm 1/3
        | wgsl {
            Seq [
                Direction(1, 0, 0);
                Am 0;
            ]
            | Ya -0.82;
        }
        | FitLength thing1,

        Overlay [
            {5/4, 0, 1, 0},
            {5/4, 5, 1, 0},
        ]
        | Seq [Fm 1, Fm 0] | Seq [Fm 1, Fm 9/8, Fm 5/4] | Repeat 5
        | Lm 1/3
        | wgsl {
            Seq [
                Direction(0, -1, 0);
                Am 0;
            ]
            | Ya -0.8
            | Lm 1/2 
        }
        | FitLength thing1,

        Overlay [
            {5/4, -2, 1, 0},
            {9/8, -2, 1, 0},
        ]
        | Seq [Fm 1, Fm 0]  | Seq [Fm 1, Fm 9/8, Fm 5/6] | Repeat 5
        | Lm 1/3
        | wgsl {
            Seq [
                Direction(0, -1, 0);
                Am 0;
            ]
            | Ya -0.8
            | Lm 1/2 
            | Xa 1
        }
        | FitLength thing1,

        Overlay [
            {5/4, 0, 1, 0},
            {9/8, 0, 1, 0},
        ]
        | Seq [Fm 1, Fm 0] | Seq [Fm 3/4, Fm 9/8, Fm 5/6, Fm 15/16, Fm 1, Fm 3/4] | Repeat 3
        | wgsl {
            Seq [
                Direction(0, -1, 0);
                Direction(1, 0, 0)
                | Xa -0.45
                | Ya 0.75;
                Direction(0.2, 1, 0)
                | Xa -0.45
                | Ya 0.75
                | Lm 1/2
                | Bend (-0.1, 0, 0, -0.1);
                Am 0;
            ]
            | Ya -0.8
            | Xa 0.5
            | Lm 4/5 
        }
        | FitLength thing1,

        Overlay [
            {5/4, -2, 1, 0},
        ]
        | Seq [Fm 1, Fm 0]  | Seq [Fm 1, Fm 9/8] | Repeat 5
        | Lm 1/3
        | wgsl {
            Seq [
                Direction(0, -1, 0);
                Am 0;
            ]
            | Ya -0.8
            | Lm 1/2 
            | Xa 1
        }
        | FitLength thing1,
    ]
}

main = {
    Overlay [
        thing1,
        thing2
    ] | Fm 4/3
    | Repeat 10
    | wgsl {
        r = 0.4;
        Sm 1.3;
    }
    | Overlay [
        Sine
        | Color [blue, red, magenta, cyan, hotpink],
        -- Overdrive(10, 0.1)
        -- | Color [black, white],
        -- Bitcrusher (16, 1, 1)
    ]
}
