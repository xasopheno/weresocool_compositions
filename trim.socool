{ f: 311.127, l: 1, g: 1/3, p: 0 }

thing1 = {
    Overlay [
        {3/2, -1, 1/3, 0},
        {1/1, 2, 1, 1},
        {1/1, 0, 1, -1},
        {1/2, 0, 1, 0},
    ]
    | Seq [
        Fm 1, Fm 9/8, Fm 5/4
    ]
}

thing2 = {
    Overlay [
        {1/1, 3, 1, 1},
        {1/1, 0, 1, -1},
    ]
    | Seq [
        Fm 3/4,
        Fm 1/3,
    ]
    | FitLength thing1
}

main = {
    Overlay [
        thing1,
        thing2
    ] 
    | ModBy [
        $a, Lm 2, $b | Lm 1/4, Lm 3, $c
    ] -> [
    b, a, 
    c | Lm 2, 
    Seq [Fm 7/4, Fm 7/1] | Lm 1/16, 
    b, a, a | Fm 3/4 | Lm 1/5
    ]
    | Repeat 2
    | Repeat 4
    | Overlay [
        -- Sine, 
        Wavefolder(0.2, 1.0, 8)
    ]
}
