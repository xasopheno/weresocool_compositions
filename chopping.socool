{ f: 311.127, l: 1, g: 1/3, p: 0 }

thing1Base = {
    Overlay [
        { 2/1, 4, 1/3, 0 },
        { 1/1, 2, 1, 1/4 },
        { 1/1, 0, 1, -1/4 },
    ]
    | Overlay [
        Fm 3/2,
        Fm 1,
    ]
    | Overlay [
        Fm 4/3,
        Fm 1,
    ]
    | Seq [
        Fm 1, Fm 5/4, Fm 4/3 | Seq [Fm 1, Fm 15/16, Lm 1] | Lm 1/3, Fm 3/2, Fm 5/3
    ]
    | Seq [AsIs, Reverse | ModBy [Lm 8, Fa -10]]
    | Lm 1/4
    | wgsl {
        Sm 3;
        Xa "sin(time * 0.5) * 0.5 + 0.5";
        Ya "cos(time * 0.7) * 0.3 + sin(time * 1.3) * 0.2";
        Seq [
            Direction (-0.5, 0.3, -1);
        ];
    }
}

thing2Base = {
    Overlay [
        { 1/1, 3, 1, 1 },
        { 1/1, 0, 1, -1 },
    ]
    | Seq [
        Fm 1/1, Fm 1/2, Fm 1/4, Fm 3/4, Fm 5/4
    ]
    | Repeat 2
    | wgsl {
        Sm 3/2;
        Xm 1/3;
        Vm 3;
        Xa "cos(time * 3) * sin(time * 5) * 0.25";
        Ya "sin(time * 8) * 0.15 + cos(time * 11) * 0.12";
        Seq [
            Direction (-1, 0.3, 0) | Lm 1;
            Direction (0.5, 0.5, 0.7) | Lm 1;
            Sm 0;
        ];
    }
    | FitLength thing1Base
}

thing3base = {
    Overlay [
        { 2, 0, 1, 0 },
        { 3/2, 0, 1/2, 0 },
        { 1/1, 2, 1, 1/4 },
        { 1/1, 0, 1, -1/4 },
        { 1/2, 0, 1, 0 },
    ]
    | Seq [
        Fm 2/1 | Lm 32, Fm 3/2, Fm 4/3 | Seq [Fm 1, Fm 15/16, Lm 1] | Lm 1/3, Fm 3/2 | Lm 1/3
    ] | Repeat 8
    | ModBy [
        Seq [
            Lm 8, Fm 0, Fa -10, Lm 8
        ] | Repeat 24
    ]
}

coloredBase(c1, c2) = {
    Overlay [
        thing1Base | #a | c1,
        thing2Base | #b | c2,
    ]
    | Seq [Fm 1, Fm 5/4]
    | Overlay [
        Sine,
        Sine 3/2
    ]
    | Repeat 4
}

seqWithColors(colorOp1a, colorOp1b, colorOp2a, colorOp2b) = {
    Seq [
        coloredBase(colorOp1a, colorOp1b) | Fm 1,
        coloredBase(colorOp2a, colorOp2b) | Fm 8/9 | Reverse,
        coloredBase(colorOp1a, colorOp1b) | Fm 1
    ]
}

melody = {
    seqWithColors(
    Color [firebrick, orange, yellow, black, black, black] | Gradient(0, 1, 0),
    Color [white, darkpink, teal, darkblue, black, black, black] | Gradient(0, 1, 0),
    Color [purple, magenta, pink, black, black, black] | Gradient(0, 1, 0),
    Color [white, lime, green, forestgreen, black, black, black] | Gradient(0, 1, 0)
    )
}

seq1 = {
    Overlay [
        melody,
        thing3base
        | FitLength melody | #c | Color [yellow, black, bluegreen, darkgreen, blue, purple, black] | Gradient(1, -1, -1)
        | Fm 1/6
        | wgsl {
            Sm "3 / (2.0 * time + 0.9)";
            Xm 1/3;
            Vm 1/2;
            Ya 5/3;
            Xa -2.0;
            Ya "cos(time * 2) * 0.14";
            Seq [
                Direction (1, 0.3, 0) | Lm 2;
                Sm 0;
            ];
        }
    ]
}

main = {
    seq1
    -- | Color [vomitgreen]
} -> [a, b]
