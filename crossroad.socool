{ f: 311.127, l: 1, g: 1/3, p: 0 }

thing1 = {
    Overlay [
        { 2/1, 0, 1, 0 } | Color [red, blue, lightblue],
        { 1/1, 2, 1, 1 } | Color [green, yellow, orange],
        { 1/1, 0, 1, -1 } | Color [purple, pink, grey],
    ]
    | Overlay [
        Seq [Fm 2, Fm 1, Fm 1/2, Fm 1/4, Fm 0, Fm 0] | Lm 1/32 | Sine 1/1 | Wavefolder (0.4, 8, 2, 0.20),
        Fm 1
    ]
    | Seq [
        Fm 1/2 | Overlay [Fm 1, Fm 3/2] | Lm 2, Fm 3/4, Fm 5/6, Fm 5/4 ,
        Fm 9/8, Fm 3/4, Fm 5/12, Fm 5/4 | Overlay [Fm 1, Fm 5/4],
        Fm 9/8 | Overlay [Fm 1, Fm 5/4], Fm 1/3 | Overlay [Fm 1, Fm 3/2], Fm 5/6, Fm 1/1,
        Fm 1/2 | Overlay [Fm 1, Fm 3/2], Fm 5/8, Fm 3/4, Fm 5/4, Fm 5/6
    ]
    | Lm 1/7
    | Repeat 6
    | wgsl {
        Ya 2;
        Ya -1.5;
        Za -1;
        Sm 3.4;
        Xa -0.5;
        Seq [
            -- Direction("cos(time * 1) * 0.5", "sin(time * 1) * 0.3", "sin(time * 1) * 0.3") | Lm 8 | Vm 3;
            -- Sm "3 / time";
            -- Am 1
            -- | Direction (1, 0, 0)
            -- | y = y + sin(time * 2)
            -- | Bend (0, -0.1, -0.1, 1) | Lm 2;
            Direction (1, sin(time * 8), sin(time * 8)) | Lm 4;
            Sm 0;
        ];
        scale = log(scale + 1) * 2;
        x = x * 0.5;
        y = y * 0.5;
        z = z * 0.5;
    }
}

thing2 = {
    Overlay [
        Seq [Fm 1/4, Fm 0, Fm 0] | Lm 1/16 | Sine 3/2 | Wavefolder (0.2, 8, 2, 0.20),
        Seq [Fm 1/2, Fm 0, Fm 0] | Lm 1/8
    ]
    | Overlay [
        { 2/1, 3, 1, 1/2 },
        { 2/1, 0, 1, -1/2 },
        { 3/2, 3, 1, 1/2 },
        { 3/2, 0, 1, -1/3 },
        { 1/1, 3, 1, 1/3 },
        { 1/1, 0, 1, -1/3 },
        { 1/2, 3, 1, 1/4 },
        { 1/2, 0, 1, -1/4 },
        { 1/4, 3, 1, 1/4 },
        { 1/4, 0, 1, -1/4 },
    ]
    | Seq [
        Fm 1/2, Fm 1/2, Fm 1/2, Fm 1/2
    ]
    | wgsl {
        Sm 4;
        Seq [
            Direction (0, 0, -1) | Bend (0, -1, 0, 1) | Lm 5;
            Direction (0, 0, -1) | Lm 6
            | Bend (-1, 0, 0, 1);
            Am 0;
        ];
    }
    | Gm 3/4
    | Color [red, purple, black]
    | Repeat 9
    | FitLength thing1
}

thing3 = {
    Overlay [
        { 2, 2, 1/8, 1/8 },
        { 2, 0, 1/8, -1/8 },
        { 3/2, 2, 1, 1/7 },
        { 3/2, 0, 1, -1/7 },
        { 9/8, 2, 1, 1/5 },
        { 9/8, 0, 1, -1/5 },
        { 1/1, 3, 1, 1/6 },
        { 1/1, 0, 1, -1/6 },
    ]
    | Seq [Fm 5/4, Fm 5/6, Fm 3/2, Fm 9/8, Fm 15/8 | Lm 4]
    | Seq [Fm 1, Fm 0, Fm 0]
    | FitLength thing1
    | wgsl {
        Ym 2;
        Ya 0.5;
        Sm 10;
        Seq [
            Direction (0, 0, -1) | Bend (0, 1, 0, 1) | Lm 5;
            Direction (0, 0, -1)
            | Bend (0, 0.2, 1, 0.3) | Lm 6;
            Am 0;
        ];
    }
    | Color [blue, grey, green]
    | Color [white, yellow, orange, darkred, darkblue, black] | Gradient(1, 1, 0)
}

main = {
