{ f: 311.127, l: 1, g: 1/3, p: 0 }

thing1 = {
    Overlay [
        { 3/2, 4, 1/2, 1/2 },
        { 3/2, 0, 1/2, -1/2 },
        { 1/1, 3, 1, 1/3 },
        { 1/1, 0, 1, -1/3 },
        { 1/2, 2, 1, 1/4 },
        { 1/2, 0, 1, -1/4 },
    ]
    | Overlay [
        Seq [Fm 0, Fm 2, Fm 2] | Lm 1/6,
        Fm 1,
    ]
    | Seq [
        Fm 5/8, Fm 9/8 | Lm 2/3, Fm 1 | Lm 4/3,
        Fm 9/16 | Overlay [Fm 1, Fm 5/3, Fm 5/2], Fm 15/16 | Lm 2,
        Fm 2/3, Fm 3/4 | Overlay [Fm 1, Fm 3/4, Fm 5/2], Fm 5/4,
        Fm 9/8, Seq [Fm 5/2 | Overlay [Fm 1, Fm 5/8, Fm 3/4], Fm 15/16, Fm 7/12, Fm 1/2, Fm 9/16, Fm 2/3] | Lm 1/2,
    ]
    | Color [firebrick, white, grey, black, black, black] | Gradient(0, 1, 0)
    | wgsl {
        Seq [
            Direction (0, 0, -1);
        ];
    }
    | Overlay [
        Sine,
        Wavefolder(0.2, 8, 2, 1)
    ]
    | Repeat 4
}

thing2 = {
    Overlay [
        { 1/1, 3, 1, 1 },
        { 1/1, 0, 1, -1 },
    ]
    | Seq [
        Fm 3/4 | Lm 6, Fm 1/4 | Lm 2
    ]
    | FitLength thing1
    | Color [blue, grey, black, black, black] | Gradient(0, 1, 0)
    | wgsl {
        Seq [
            Direction (0, -0.2, -1) | Lm 8;
        ];
    }
}

main = {
    Overlay [
        thing1,
        -- thing2
    ]
    | Repeat 3
    | Lm 1/3
}
