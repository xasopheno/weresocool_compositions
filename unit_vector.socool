{ f: 311.127, l: 1, g: 1/3, p: 0 }

thing1 = {
    Overlay [
        { 1/1, 2, 1, 1/2 },
        { 1/1, 0, 1, -1/2 },
        { 1/2, 0, 1, 0 },
    ]
    | Seq [
        Fm 1, Fm 4/3, Fm 3/2, Fm 2
    ]
    | Seq [AsIs, Reverse]
    | Lm 1/7
    | Seq [
        Fm 1, Fm 9/8, Fm 5/4, Fm 5/3 | Lm 4
    ]
    | wgsl {
        Lm 1/5;
        Za -1;
        Vm 1;
        Xm 1/3;
        Ym 3/2;
        Seq [
            Direction(1, 0, 0)
            | Lm 1
            | Bend (0, 1, 0, 1);
            Direction(1, 0, 0)
            | Lm 1
            | Bend (0, -1, 0, 1);
            Direction(0, 1, 0)
            | Lm 2;
            Direction(1, 0, 0)
            | Lm 2;
            -- | Bend (1, 0, 0, 1);
            Am 0.0;
        ]
        | Bend (1, -0.3, 0, 0.4)
    }
    | Color [red, white, black, yellow]
    | wgsl {
        Ym 3/2;
        Seq [
            Direction(-0.3, 0.2, -1) | Lm 1/2 | Vm 1/2;
            Direction(0.7, -0.5, 0);
            Direction(0, 1, -1) | Vm 2;
            Direction(1, 1, -0.4) | Vm 3;
            Am 0.0;
        ]
    }
}

thing2 = {
    Overlay [
        { 1/1, 3, 1, 1 },
        { 1/1, 0, 1, -1 },
        { 1/2, 0, 1, 0 },
    ]
    | Seq [Fm 1/2, Fm 1]
    | Repeat 4
    | Seq [
        Fm 3/4 | Lm 3, Fm 1/3
    ]
    | wgsl {
        Ym 3/2;
        Seq [
            Direction(-0.3, 0.2, -1) | Lm 1/2 | Vm 1/2;
            Direction(0.7, -0.5, 0);
            Direction(0, 1, -1) | Vm 2;
            Direction(1, 1, -0.4) | Vm 3;
            Am 0.0;
        ]
    }
    | Color [blue]
    | FitLength thing1
}

main = {
    Overlay [
        thing1,
        thing2
    ]
    | wgsl {
        Sm 2;
        Sm 2;
        Seq [
            Vm 2 | Lm 4;
            Vm 2;
        ]
    }
    | Repeat 8
}
