{ f: 65, l: 1/2, g: 1, p: 0, w: 1.6, h: 0.9, background_color: #05060c, rand_seed: 42 }

-- SYNC DIAGNOSTIC. One voice, one obvious note per second, no dice.
-- Every blip should land exactly on a big arc appearing. If audio and
-- video drift or offset HERE, the bug is in the engine's time mapping
-- (print pipeline or realtime clock), not in the composition.
-- Section two switches to a Choose to test the dice path the same way:
-- you should hear a blip on exactly the pulses where an arc appears,
-- and silence where nothing appears.
--
-- Play:  kintaro glitch? -> kintaro blip_sync_test.socool
-- Print: kintaro print blip_sync_test.socool

light key = { from: (-1.2, 1.1, 0.6), color: #ffd9a0, gain: 1.30 }

draw flash = {
    let k = Wrap(Count, 8.0)
    let ax = 0.0 - 1.05 + k * 0.30

    Point
    | Spawn { n: 120, by: Sm(0.9990) }
        | Xa(sin(Stroke * 6.28318) * 0.22)
        | Ya(cos(Stroke * 6.28318) * 0.44)
    | Gradient
    | Xf(ax)
    | Tint(1.0, 1.0, 1.0, 0.9)
}

x = { Silence 1 }

bl = {
    Tom glass | Fm 2 | Gm 0.8
    | Color [#f4fbff, #6bb4d8, #17497e]
    | wgsl {
        Sm "0.5 * (1.0 + 2.0 * exp(0.0 - Time * 3.0))";
        Bm "3.0 * exp(0.0 - Time * 2.0) + 0.3";
        Vm 0.0; Die 0.9;
    }
    | flash
}

steady = {
    Seq [bl, bl | Fm 9/8, bl | Fm 5/4, bl | Fm 3/2] | Repeat 4
}

diced = {
    Choose [
        x,
        x,
        bl,
        bl | Fm 9/8,
        bl | Fm 5/4,
        bl | Fm 3/2
    ] | Repeat 16
}

main = {
    Seq [
        steady,
        x | Lm 2,
        diced,
        x | Lm 2,
        diced
    ]
}
