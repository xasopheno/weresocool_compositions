{ f: 311.127, l: 1, g: 1/3, p: 0 }

thing1 = {
    Overlay [
        { 11/8, 2, 1, 1 },
        { 11/8, 0, 1, -1 },
        { 9/8, 2, 1, 1 },
        { 9/8, 0, 1, -1 },
        { 1/1, 2, 1, 1 },
        { 1/1, 0, 1, -1 },
        { 3/4, -3, 1, 1 },
        { 3/4, 0, 1, -1 },
        { 1/2, 1, 1, 1/3 },
        { 1/2, 0, 1, -1/3 },
    ]
    | Seq [
        Seq [
            Fm 7/6, Fm 1/4
        ]
        | Repeat 5,
        Seq [
            Fm 7/4, Fm 1/3
        ]
        | Repeat 5,
        Seq [
            Fm 1, Fm 5/8
        ]
        | Repeat 5,
        Seq [
            Fm 7/4, Fm 1/2
        ]
        | Repeat 5,
    ]
    | Lm 1/13
    | Color [orange, blue, purple, black, black, black] | Gradient(0.5, 1, -0.3)
    | wgsl {
        Rz 8;
        Ry 8;
        Rx 8;
        Sm 15;
        Vm 8;
        Xm "(3/2 / (time + 1.0))";
        Ym "(3/2 * (time + 1.0))";
        Seq [
            Direction (0, 0, -1);
        ];
    }
    | Overlay [Sine, Sine 3/2 | Gm 1/2, Tri 3/2 | Gm 1/2]
    | Seq [Fm 1, Fm 5/4 | Reverse]
}

