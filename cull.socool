{ f: 311.127, l: 1, g: 1/3, p: 0 }

-- ─── post-process ────────────────────────────────────────────────────────
-- Dream: gentler post-process. Less curl, less blur, faster decay than
-- before — each mark stays a recognizable mark instead of being dragged
-- into a horizontal smear. Bloom catches the centers; gamma keeps things
-- saturated.
warp dream = {
    Prev
    | CurlFlow { amp: 0.003, freq: 14 }
    | Blur 0.7
    | Decay 0.92
    | Add (Scene | Bloom { threshold: 0.3, strength: 0.45 })
    | Knee 0.35
    | Gamma 1.18
}

-- ─── marks ───────────────────────────────────────────────────────────────
-- flower: 4 petals at radius 0.04 around the source note, each petal a
-- 4-step outward stroke noise-displaced for organic waver.
-- 4 × 4 = 16 emits per note (was 30 — easier on accumulation).
draw flower = {
    Point
    | Xa(0.04)
    | Spawn { n: 4, by: Rz(Tau/4) }
    | Each(Point | Lerp { to: Direction(0.05, 0.028, 0), n: 4 })
    | Modulate(Noise { scale: 4 }, 0.006)
}

-- stem: every stem terminates at the SAME world point (0, -0.7, 0). The
-- vase. Math:
--   x: note's world x is -note.x (kintaro flips pan). Offset +note.x lands
--      the endpoint at world x = 0.
--   y: the shader maps i_pos_scale.y from [0,1] to [-1,1] via (y·2 - 1).
--      To make every stem land at world y = -0.7 regardless of pitch, we
--      need i_pos_scale.y = 0.15, so offset.y = 0.15 - note.y.
-- Clean, dense, no noise — the jagged "fish-spine" look in the last try was
-- Modulate making each emit visible as a discrete dot. 24 emits per stem
-- packs them tightly enough that they read as a continuous line.
draw stem = {
    Point
    | Lerp { to: Direction(Note.x, 0.15 - Note.y, 0), n: 24 }
}

-- ─── audio sources ──────────────────────────────────────────────────────
thing1 = {
    Overlay [
        { 2/1, 3, 1, 1 },
        { 2/1, 0, 1, -1 },
        { 1/1, 2, 1, 1 },
        { 1/1, 0, 1, -1 },
    ]
    | Seq [
        Fm 0 | Lm 3,
        Fm 3/2, Fm 7/8 | Lm 2,
        Fm 4/3, Fm 5/6 | Lm 2,
        Fm 9/8, Fm 5/8 | Lm 2,
        Fm 2/3 | Lm 1,
        Fm 3/8 | Lm 3,
        Fm 0,
        Seq [
            Fm 9/8 | Lm 2,
            Fm 7/6 | Lm 1,
            Fm 4/3 | Lm 1,
            Fm 5/3 | Lm 1,
            Fm 3/2 | Lm 1,
            Fm 5/4 | Lm 2,
            Fm 2 | Lm 1/2,
            Fm 9/4 | Lm 1/2,
            Fm 4/3 | Lm 1/2,
            Fm 5/4 | Lm 1/8,
            Fm 4/3 | Lm 5/3,
            Fm 11/8 | Lm 1/6,
            Fm 4/3 | Lm 2,
        ] | Overlay [Fa 0, Fa 1],
        Fm 4/3 | Lm 2,
        Overlay [
            { 4/3, 0, 1, 0 },
            { 3/2, 0, 1, -1/2 },
        ] | Lm 4,
        Overlay [
            { 4/3, 0, 1, 0 },
            { 3/2, 0, 1, -1/2 },
            { 5/3, 0, 1, 1/2 },
            { 5/3, 0, 1, 1/2 },
        ] | Lm 2,
        Overlay [
            { 4/3, 0, 1, 0 },
            { 3/2, 0, 1, -1/2 },
            { 5/3, 0, 1/2, 1/2 },
            { 9/4, 0, 1/2, -1/8 },
        ] | Lm 2,
        Overlay [
            { 4/3, 0, 1, 0 },
            { 3/2, 0, 1, -1/2 },
            { 5/3, 0, 1, 1/2 },
            { 9/4, 0, 1/2, -1/8 },
            { 5/2, 0, 1/2, 1/8 },
        ] | Lm 2,
        Overlay [
            { 5/4, 0, 1, 0 },
            { 5/3, -4, 1, -1/2 },
            { 5/3, 0, 1, 1/2 },
            { 8/3, -6, 1/2, -1/8 },
            { 8/3, 0, 1/2, 1/8 },
        ] | Lm 2,
        Overlay [
            { 3/2, 0, 1, 0 },
            { 5/3, -4, 1, -1/2 },
            { 5/3, 0, 1, 1/2 },
            { 8/3, -6, 1/2, -1/8 },
            { 8/3, 0, 1/2, 1/8 },
            { 2, 0, 3/4, -2/3 },
            { 2, 4, 3/4, 2/3 },
            { 5/2, 0, 1/4, -2/3 },
            { 5/2, 2, 1/4, 2/3 },
        ] | Lm 4,
        Overlay [
            { 5/4, 0, 1, 0 },
            { 3/4, -8, 1, -1/2 },
            { 1/4, 0, 1, 1/2 },
            { 1/4, -8, 1/2, -1/8 },
            { 1/4, 0, 1/2, 1/8 },
        ]
        | Lm 2
        | Gm 1/6
        | Portamento 16,
    ]
    | Overlay [
        Sine,
        Fm 1/2
        | Overlay[
            Overdrive(20, 0.05),
        ]
    ]
}

thing2 = {
    Overlay [
        { 9/4, 5, 1, 1/4 },
        { 9/4, 0, 1, -1/4 },
        { 3/2, 3, 1, 1 },
        { 3/2, 0, 1, -1 },
        { 1/1, 3, 1, 1 },
        { 1/1, 0, 1, -1 },
    ]
    | Seq [
        Fm 1,
    ]
    | FitLength thing1
    | Fm 1/2
    | Bitcrusher(16, 1, 1)
}

-- ─── four flowers ────────────────────────────────────────────────────────
-- Same melodic content, four parallel transpositions making a stacked chord
-- (unison + fifth + octave + major third), each routed through its own
-- color brush and its own wgsl block giving slightly different drift. Each
-- audible note triggers four flowers in four colors at once — a bouquet.
-- Gain divided so the chord doesn't dominate.

-- Flowers wiggle in x and z only — zero in y. They stay at their bloom
-- pitch (no upward streaking) but drift sideways and depth-wise enough to
-- cross other voices' territory over the duration. Each color has its own
-- (x, z) vector so the three drift differently and intermingle.
flower_rose = {
    thing1
    | Gm 1/3 | Pa -1/4
    | Color [vividpurple, firebrick, deepred, black, black]
    | Gradient(0, 1, 0)
    | wgsl {
        Sm 0.30;
        Vm 1/8;
        Seq [
            Direction (0.10, 0, -0.08) | Lm 8;
        ];
    }
    | draw flower
}

flower_amber = {
    thing1 | Fm 3/2
    | Gm 1/3 | Pa 1/8
    | Color [gold, darkorange, firebrick, deepred, black]
    | Gradient(0, 1, 0)
    | wgsl {
        Sm 0.29;
        Vm 1/8;
        Seq [
            Direction (-0.12, 0, -0.05) | Lm 8;
        ];
    }
    | draw flower
}

flower_violet = {
    thing1 | Fm 5/4
    | Gm 1/3 | Pa -1/8
    | Color [vividpurple, deeppurple, blue, darkpurple, black]
    | Gradient(0.3, 1, 0)
    | wgsl {
        Sm 0.305;
        Vm 1/8;
        Seq [
            Direction (0.06, 0, -0.12) | Lm 8;
        ];
    }
    | draw flower
}

-- ─── stems ──────────────────────────────────────────────────────────────
-- The bitcrushed harmony anchors the bouquet. Very slow drift so the vase
-- shape persists — each stem holds its converging Lerp instead of sweeping
-- away into a streak field.
stems = {
    thing2
    | Color [deepgreen, bluegreen, turquoise, deeppurple, black]
    | Gradient(0, 1, 0)
    | wgsl {
        -- Stems with a little more body — 40% bigger than the previous
        -- threadlike version. Still small enough that 24 dots-per-line
        -- read as continuous strokes, just with weight to them now.
        Sm 0.320;
        Vm 1/20;
        Seq [
            Direction (0, -0.015, -0.03) | Lm 8;
        ];
    }
    | draw stem
}

main = {
    Overlay [
        flower_rose,
        flower_amber,
        flower_violet,
        stems,
    ]
    | dream
    | Repeat 3
    | Fm 9/8
}
