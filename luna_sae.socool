{ f: 311.127, l: 1, g: 1/3, p: 0 }

warp impasto = {
    Prev
    | CurlFlow { amp: 0.025, freq: 5 }
    | Modulate(Noise { scale: 1.6, offset: 0.020 }, 0.11)
    | Blur 3.1
    | Decay 0.88
    | Add (Scene | Bloom { threshold: 0.18, strength: 0.66 })
    | Knee 0.25
    | Gamma 1.68
}

draw stroke = {
    Point | Lerp { to: Direction(0.04, 0.2, -0.5), n: 13 }
        | Modulate(Noise { scale: 0.3 }, 0.01)
}

thing1 = {
    Overlay [
        { 1/1, 2, 1, 1 },
        { 1/1, 0, 1, -1 },
        { 1/2, 2, 1/2, 1/4 },
        { 1/2, 0, 1/2, -1/4 },
    ]
    | Overlay [
        Seq [Fm 0, Fm 4, Fm 0] | Lm 1/5 | Gm 1/2,
        Seq [Fm 0, Fm 0, Fm 3] | Lm 1/5 | Gm 1/2,
        Seq [Fm 2, Fm 0, Fm 0] | Lm 1/8,
        Fm 1 | Gm 1/5,
        Seq [Fm 1/2, Fm 0, Fm 0] | Lm 1/3,
    ]
    | Seq [
        Fm 3/2, Fm 9/8, Fm 1/4 | Lm 2,
        Fm 5/4, Fm 9/8, Fm 2/3,
        Fm 4/3, Fm 25/24, Fm 5/8 | Lm 2,
        Fm 8/5, Fm 4/3, Fm 4/5,
        Fm 3/2, Fm 9/8, Fm 1/2 | Lm 2,
        Fm 5/4, Fm 9/8, Fm 2/3,
        Fm 4/3, Fm 25/24, Fm 5/4 | Lm 2,
        Fm 8/5, Fm 4/3, Fm 4/5,
    ]
    | Lm 1/9
    | Repeat 8
    | Color [darkblue, darkpurple, grey, black, black, black] | Gradient(0, 1, 0)
}

thing2 = {
    Overlay [
        { 2/1, 3, 1, 1 },
        { 2/1, 0, 1, -1 },
        { 1/1, 3, 1, 1/3 },
        { 1/1, 0, 1, -1/3 },
    ]
    -- | Overlay [
    -- Seq [Fm 0, Fm 0, Fm 3] | Lm 1/5 | Gm 1/2,
    -- Seq [Fm 2, Fm 0, Fm 0] | Lm 1/8,
    -- Fm 1,
    -- Seq [Fm 1/2, Fm 0, Fm 0] | Lm 1/3,
    -- ]
    | Seq [
        Fm 0, Fm 3/4, Fm 5/4, Fm 4/3,
        Fm 3/2, Fm 8/5, Fm 3/2, Fm 5/4,
        Fm 9/8, Fm 3/4, Fm 5/4, Fm 4/3,
        Fm 0, Fm 3/4, Fm 5/4, Fm 4/3,
        --
        Fm 0, Fm 3/4, Fm 5/4, Fm 4/3,
        Fm 3/2, Fm 8/5, Fm 7/4, Fm 3/2,
        Fm 5/4, Fm 9/8, Fm 5/4, Fm 4/3,
        Fm 0, Fm 3/4, Fm 1 | Lm 2,
    ]
    | FitLength thing1
    | Color [darkred, brightred, grey, black, black, black] | Gradient(0.5, 1, 0)
    | wgsl {
        Sm 2;
    }
}

main = {
    Seq [
        Overlay [
            thing1,
        ],
        Overlay [
            thing1,
            thing2
        ]
    ]
    | wgsl {
        Seq [
            Xm "sin(Time)";
            Ym "sin(Time * 0.3) * 3";
            Direction (0, -0.2, -1) | Bend(0.08, -0.18, 0, 0.5) | Lm 8;
        ];
    }
    | Repeat 3
    | impasto
    | draw stroke
}
