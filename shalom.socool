    ]
}

thing2 = {
    Overlay [
        { 3/1, -0.02, 1, -1 },
        { 3/1, 0, 1, 1 },
        { 5/3, -0.02, 1, -1 },
        { 5/3, 0, 1, 1 },
        { 4/3, -0.02, 1, -1 },
        { 4/3, 0, 1, 1 },
        { 1/1, -0.02, 1, -1 },
        { 1/1, 0, 1, 1 },
    ]
    | Seq [
        Fm 3/4, Fm 11/16 | Lm 1/8, Fm 3/4, Fm 1/2,
        Fm 3/4, Fm 11/16 | Lm 1/8, Fm 3/4 | Lm 1/8, Fm 0 | Lm 2,
        -- Fm 9/16, Fm 5/8, Fm 9/16, Fm 2/3 | Lm 3,
        -- Fm 2/3, Fm 5/8 | Lm 2
    ]
    | FitLength thing1
    | Color [blue, grey, black, black, black] | Gradient(0, 1, 0)
    | wgsl {
        Xm 1/3;
        Seq [
            Direction (1, 1, 1) | Bend (0.4, 2, 0.2, 0.3) | Vm 1/8 | Lm 4;
            Direction (0.2, 1, 1) | Bend (-0.2, 0, 0, 0.5) | Vm 1/2 | Lm 4;
            Sm 0;
        ];
        Xa "cos(time * 0.5 - y * 1.5) * 0.06";
        Ya "sin(time * 0.25 + x * 2.0) * 0.04";
        Rx "time * 0.08";
        Ry "sin(time * 0.12) * 0.15";
        Sm 3.5;
        Am "0.8 + sin(life * 3.0) * 0.2";
    }
}

main = {
    Overlay [
