{ f: 220, l: 1, g: 1/3, p: 0 }

thing1 = {
    Overlay [
        { 1/1, 2, 1, 1 },
        { 1/1, 0, 1, -1 },
    ]
    | Seq [
        Fm 1,
        Fm 9/8,
        Fm 5/4,
        Fm 4/3,
        Fm 3/2,
        Fm 5/3,
        Fm 15/8,
        Fm 2
    ]
    | Seq [Fm 1, Reverse]
    | Overlay [AsIs, Invert]
    | Lm 1/32
    | Seq [Fm 1, Fm 3/2, Fm 25/24, Fm 0]
    | Repeat 3
    | Color [firebrick, white, grey, black, black, black] | Gradient(0, 1, 0)
    | wgsl {
        Seq [
            Direction (0, 0, -1);
        ];
    }
}

thing2 = {
    Overlay [
        { 5/2, 0, 1, 0 },
        { 1/1, 3, 1, 1 },
        { 1/1, 0, 1, -1 },
    ]
    | Seq [
        Fm 3/4 | Lm 6, Fm 1/4 | Lm 2
    ]
    | Repeat 2
    | FitLength thing1
    | Color [blue, grey, black, black, black] | Gradient(0, 1, 0)
    | wgsl {
        Seq [
            Direction (0, -0.2, -1) | Lm 8;
        ];
    }
}

thing3 = {
    Overlay [
        { 11/8, 4, 1, 0 },
        { 11/8, 0, 1, 0 },
        { 9/8, 3, 1, 1 },
        { 9/8, 0, 1, -1 },
        { 3/4, 4, 1, 0 },
        { 3/4, 0, 1, 0 },
    ]
    | Fm 2
    | FitLength thing1
}

main = {
    Overlay [
        thing1,
        thing2,
        thing3
    ]
    | Overlay [
        Square
    ]
    | Repeat 120
    | Lm 1/60
    | Repeat 3
}
