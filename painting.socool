{ f: 311.127, l: 1, g: 1/3, p: 0, background_color: #000000 }

-- WHITE GROUND: boot the buffer to white, multiply fresh pigment into it,
-- heal back toward white almost imperceptibly. Subtractive painting.
warp gesso = {
    Prev
    | Raw {
        let boot = step(color.r + color.g + color.b, 0.003);
        let canvas = mix(color.rgb, vec3<f32>(1.0), boot);
        let m = textureSample(scene_tex, scene_samp, clamp(uv, vec2<f32>(0.0), vec2<f32>(1.0)));
        let pig = clamp(m.rgb * 1.7, vec3<f32>(0.0), vec3<f32>(1.0));
        let heal = vec3<f32>(1.0) - (vec3<f32>(1.0) - canvas) * 0.9940;
        color = vec4<f32>(heal * (vec3<f32>(1.0) - pig * 0.82), 1.0);
    }
    | Opaque
}

-- warm cotton-paper tone + two octaves of grain — once per frame, never fed back
warp linen = {
    Scene
    | Raw {
        let g = 1.0 - 0.05 * k_vnoise(uv * 150.0) - 0.04 * k_vnoise(uv * 55.0);
        let warm = vec3<f32>(0.965, 0.94, 0.885);
        color = vec4<f32>(color.rgb * warm * g, 1.0);
    }
}

-- a curving calligraphic stroke with a ghost double-gesture trailing it
draw stroke = {
    Point 
    | Lerp { to: Direction(0.155, 0.008, 0), n: 10 }
    | Smooth(16)
    | Modulate(Noise { scale: 5.4 }, 0.08)
    -- | Tint(1 - 0.25 * Stroke, 1 - 0.25 * Stroke, 1 - 0.85 * Stroke)
    | Echo { n: 2, dt: 0.1, decay: 0.5 }
}

melody = {
    Overlay [
        { 1/1, 3, 1, 1/3 }, 
        { 1/1, 0, 1, -1/3 }
    ]
    | Seq [Fm 1, Fm 9/8, Fm 5/4, Fm 3/2, Fm 5/3 | Lm 2, Fm 3/2, Fm 5/4 | Lm 2]
    | Lm 1/2
}

amber = {
    Overlay [
        { 1/1, 3, 1, 0 }, 
        { 1/1, 0, 1, 0 },
    ]
    | Seq [
        Seq [
            Fm 3/2, Fm 1, Fm 3/4, Fm 1/2, 
            Fm 3/4, Fm 2/3, Fm 4/3, Fm 5/4,
        ] | Repeat 3,
            Fm 5/3, Fm 9/8, Fm 5/6, Fm 5/8, 
            Fm 3/4, Fm 2/3, Fm 7/4, Fm 5/4,
    ]
    | Lm 1/6
    | Color [red, red, red, goldenrod, white, forestgreen, mediumseagreen, springgreen, black]
    | Gradient(0, 1, 0)
    | wgsl {
        Sm 0.24; Vm 1/2; Bm Slew(0.18, 4); 
        Seq [ 
            Direction(0.30, -0.00, 0) 
            | Bend(0.16, -0.36, 0, 0.5) 
            | Lm 2; 
            Bend(0.16, 0.86, 0, 0.5) 
            | Lm 2; 
            Direction(-0.30, -4.00, 0) 
            | Lm 1/8;
        ];
    }
    | stroke
}

main = {
    Overlay [
        amber, 
    ]
    | gesso
    | linen
    | Repeat 3
}
