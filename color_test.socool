{ f: 311.127, l: 1, g: 1/3, p: 0 }

thing3 = {
    Overlay [
        { 2, 2, 1/8, 1/8 },
        { 2, 0, 1/8, -1/8 },
        { 3/2, 2, 1, 1/7 },
        { 3/2, 0, 1, -1/7 },
        { 9/8, 2, 1, 1/5 },
        { 9/8, 0, 1, -1/5 },
        { 1/1, 3, 1, 1/6 },
        { 1/1, 0, 1, -1/6 },
    ]
    | Seq [Fm 5/4, Fm 5/6, Fm 3/2, Fm 9/8, Fm 15/8 | Lm 4]
    | wgsl {
        Ym 2;
        Ya 0.5;
        Sm 10;
        -- r = r * 3;
        Sm "1 - (Time * 1.5)";
        Seq [
            Direction (0, 0, -1) | Bend (0, 1, 0, 1) | Lm 5;
            Sm 0;
        ];
    }
    | Color [firebrick, white, grey, black, black, black] | Gradient(0, 1, 0)
}

main = {
    Overlay [
        thing3,
    ]
    | Repeat 3
}
