{ f: 311.127, l: 1, g: 1/8, p: 0 }

walls = {
    Overlay [
        FromSound(10, 10) ./underwater_explosion.mp3
    ]
    | ModBy [Lm 1/8, $a, Lm 4] -> [a]
    | ModBy [
        Seq [
            Fm 1, Fm 4/3, Fm 1, Fm 4/5
        ] | Repeat 8
    ]
    | Gm 2
    | Seq [
        Lm 3, Lm 3/4,
        Lm 1/3, Lm 1/6 | Repeat 2, Lm 1/8 | Repeat 8, Lm 1/7 | Gm 3/2, Fm 1/4 | Lm 1/10 | Gm 1/4, Gm 0 | Lm 1/100
    ]
    | Overlay [
        { 10/1, 2, 1, -1/2 },
        { 10/1, 2, 1, 1/2 },
        { 9/1, 2, 1, -1/2 },
        { 9/1, 2, 1, 1/2 },
        { 8/1, 2, 1, -1/2 },
        { 8/1, 2, 1, 1/2 },
        { 6/1, 0, 1, -1/2 },
        { 6/1, 0, 1, 1/2 },
        { 5/1, 0, 1, -1/2 },
        { 5/1, 0, 1, -1/2 },
        { 3/1, 8, 1, 1 },
        { 3/1, 0, 1, -1 },
        { 1/1, 4, 1, 1 },
        { 1/1, 0, 1, -1 },
        { 3/2, 5, 1, 1/8 },
        { 3/2, 0, 1, -1/8 },
        { 1/2, 5, 1, 1 },
        { 1/2, 0, 1, -1 },
        { 1/4, 8, 1, 1/4 },
        { 1/4, 0, 1, -1/4 },
        { 1/8, 5, 1/4, 1/4 },
        { 1/8, 0, 1/4, -1/4 },
    ]
    | Overlay [Sine, Sine 3/2 | Gm 1/3, Tri | Gm 1/8, Sine 2 | Gm 1/4]
    -- | Lm 4
}

thing1 = {
    Seq [
        walls,
    ]
    | Repeat 2
    | Color [firebrick, white, grey, black, black, black] | Gradient(0, 1, 0)
    | wgsl {
        Sm "scale * 3.0 * (1 - time) * 3.0";
        Seq [
            Direction (0, 0, -1);
        ];
    }
}

main = {
    Overlay [
        thing1 | #a,
    ]
    | Repeat 1
} -> [a, b, c]
