{ f: 311.127, l: 1, g: 1/3, p: 0 }

thing1(a) = {
    Overlay [
        { 1/1, 2, 1, 1 },
        { 1/1, 0, 1, -1 },
        { 1/2, 0.0, 1/4, 1/5 },
        { 1/2, 0.1, 1/4, -1/5 },
    ]
    | Overlay [
        a,
        Fm 1
    ]
    | Seq [
        Fm 1/2 | Overlay [Fm 1, Fm 2], Fm 9/8, Fm 5/4 | Lm 2
    ]
    | Seq [
        Repeat 8,
        Fm 7/8 | Reverse, Fm 5/4 | Lm 1/2, Fm 8/5 | Lm 1/2,
        Repeat 8,
        Fm 7/8 | Reverse, Fm 5/4 | Lm 1/2, Fm 8/5 | Lm 1/2,
    ]
    | Overlay [
        Sine,
        Wavefolder(0.4, 8, 2, 0.08),
    ]
    | Repeat 4
    | Lm 1/8
}

thing2 = {
    Overlay [
        { 3, 0, 1/7, 0 },
        { 3, 8, 1/7, 0 },
        { 5/4, 0, 1/7, 0 },
        { 5/4, 5, 1/7, 0 },
        { 9/4, 3, 1, 1 },
        { 9/4, 0, 1, -1 },
        { 1/2, 3, 1, 1 },
        { 1/2, 0, 1, -1 },
    ]
    | Seq [Fm 0 | Lm 3, Fm 3/2, Fm 1, Fm 0]
    | Seq [
        Fm 1, Fm 4/3 | Reverse, Fm 1, Fm 3/2 | Reverse
    ]
    | Overlay [
        Sine,
        Wavefolder(0.4, 8, 2, 0.08),
    ]
    | Repeat 4
    | Repeat 1
    | FitLength thing1(Lm 3/2)
}

main = {
    Overlay [
        thing1(Seq [Fm 9/4, Fm 7/4, Fm 1] | Lm 1/32),
        thing1(Seq [Fm 7/4 | Fa 1, Fm 7/4, Fm 1] | Lm 1/32),
    ]
}
