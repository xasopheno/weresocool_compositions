{ f: 311.127, l: 1, g: 1/3, p: 0 }

thing1 = {
    Overlay [
        { 5/2, 0, 1, 1/3 },
        { 9/4, 0, 1, -1/3 },
        { 5/4, 4, 1, 5/8 },
        { 9/8, 0, 1, -5/8 },
        { 1/1, 2, 1, 1 },
        { 1/1, 0, 1, -1 },
        { 1/2, 0, 1, 0 },
    ]
    | Seq [
        Fm 11/8 | Lm 6,
        Fm 1 | Lm 8,
        Fm 9/8 | Lm 4,
        Fm 5/6 | Lm 6,
        Fm 8/5, Fm 7/8, Fm 11/16, Fm 5/8,
        Fm 1/2, Fm 7/5, Fm 7/6 | Lm 2,
        Fm 1/2 | Lm 5/3, Fm 4/3 | Lm 2/3, Fm 7/6 | Lm 2,
        Seq [
            Fm 5/3, Fm 7/6, Fm 11/8, Fm 15/16, Fm 1/3,
        ] | Lm 3/5,
    ]
    | Overlay [AsIs, Reverse | Fm 2 | Repeat 2 | Lm 1/2 | Gm 1/4]
}

thing2 = {
    Overlay [
        { 1/1, 3, 1, 1 },
        { 1/1, 0, 1, -1 },
    ]
    | Seq [
        Fm 3/4 | Lm 6, Fm 1/4 | Lm 2
    ]
    | FitLength thing1
}

main = {
    Overlay [
        thing1,
        -- thing2
    ]
    | Repeat 3
    | Lm 1/3
}
