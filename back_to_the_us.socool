{ f: 311.127, l: 1, g: 1/3, p: 0 }

thing1 = {
    Overlay [
        { 3/1, 2, 1, 1/2 },
        { 3/1, 0, 1, -1/2 },
        { 2/1, 2, 1, 1/2 },
        { 2/1, 0, 1, -1/2 },
        { 3/2, 2, 1, 0 },
        { 1/1, 2, 1, 1/2 },
        { 1/1, 0, 1, -1/2 },
        { 3/4, 2, 1, 0 },
    ]
    | Overlay [
        Seq [Fm 2, Fm 0, Fm 0] | Lm 1/3,
        Fm 1 | Gm 1/4,
        Fm 1/2 | Gm 1/4
    ]
    | Seq [
        Fm 9/8, Fm 5/4 | Lm 2,
        Fm 3/2, Fm 0, Fm 9/8
    ]
    | Color [firebrick, black, black, black] | Gradient(0, 1, 0)
    | wgsl {
        Seq [
            Direction (0, -1, -1);
        ];
    }
    | Seq [Fm 0 | Lm 5, Repeat 2]
}

thing2 = {
    Overlay [
        { 2, 0, 1, 0 },
        { 1/1, 4, 1, 1/3 },
        { 1/1, 0, 1, -1/3 },
    ]
    | Seq [
        Fm 1, Fm 0, Fa -3 | Pm 1/2
    ] | Repeat 6
    | Seq [
        Fm 1/3, Fm 3/4 | Lm 3, Fm 1/2, Fm 1/4 | Lm 2, Fm 1,
    ]
    | Color [blue, black, black, black] | Gradient(0, 1, 0)
    | wgsl {
        Seq [
            Direction (0, -0.3, -1) | Lm 8;
        ];
    }
    | Overlay [AsIs, Invert | Fm 1/2 | Pm 1/8]
    | Repeat 6
    | FitLength thing1
}

thing3 = {
    Overlay [
        { 4, 0, 1/2, 0 },
        { 2/1, 3, 1/2, 1/8 },
        { 2/1, 0, 1/2, -1/8 },
        { 3/2, 0, 1, 0 },
        { 1/1, 4, 1, 1/4 },
        { 1/1, 0, 1, -1/4 },
    ]
    | Seq [
        Fm 1, Fm 0, Fa -3 | Pm 1/2
    ] | Repeat 6
    | Seq [
        Fm 0, Fm 5/3 | Lm 2, Fm 3/2 | Lm 3/2, Fm 5/4, Fm 3/2 | Lm 2, Fm 5/3, Fm 5/4, Fm 9/8, Fm 1, Fm 3/2, Fm 5/8, Fm 3/2, Fm 9/8,
    ]
    | Seq [Fm 1, Fm 0]
    | Color [green, black, black, black] | Gradient(0, 1, 0)
    | wgsl {
        Seq [
            Direction (0, -0.7, -1) | Lm 8;
            Ym "y + sin(Time / x)"
        ];
    }
    | FitLength thing1
}

dinosaur = {
    Overlay [
        thing1,
        thing2,
        thing3,
    ]
    | Fm 7/8
    | Repeat 1
    | Lm 1/4
    | wgsl {
        Sm 2.0;
        Xm 1/2;
        Ym "y + sin(Time)"
    }
}

birds = {
    Overlay [
        { 5/4, 2, 1, 1/2 },
        { 5/4, 0, 1, -1/2 },
        { 1/8, 1, 1, 1/2 },
        { 1/8, 0, 1, -1/2 },
    ]
    | Overlay [
        FromSound(20, 1) ./bird.mp3
    ]
    | ModBy [Lm 1, $a, Lm 13] -> [a]
    | ModBy [$a, Lm 3] -> [a, a | Lm 1/16 | Reverse | Fm 1/2]
    | ModBy [
        Fm 1/8, Fm 1/2, Fm 3/4 | Lm 4
    ]
    | Overlay [Fm 1, Fm 1/3]
    | Color [white, orange, yellow, black] | Gradient(0, 1, 0)
    | wgsl {
        Direction (0, 0, -1) | Lm 8;
        Ya "sin(Time * 0.1)";
        Xa "sin(Time * 0.4 * (-x + 0.001))";
        Ya -2;
        Xm 3/2;
    }
    | Overlay [
        Sine, Sine 1.1
    ]
    | Lm 4
    | Repeat 3
}

bass = {
    Overlay [
        { 5/4, 3, 1, 1/2 },
        { 5/4, 0, 1, -1/2 },
        { 1/1, 2, 1, 1/2 },
        { 1/1, 0, 1, -1/2 },
        { 1/2, 2, 1, 1/2 },
        { 1/2, 0, 1, -1/2 },
        { 1/4, 1, 1, 1/2 },
        { 1/4, 0, 1, -1/2 },
    ]
    | wgsl {
        Direction (0, 0, -1) | Lm 8;
        Ya "sin(Time * 0.1)";
        Xa "sin(Time * 0.4 * (-x + 0.001))";
        Ya -2;
        Xm 3;
    }
    | ModBy [Fa 8, Fa -7, Fa 0]
    | Repeat 5
    | Portamento 8
    | FitLength birds
}

main = {
    Seq [
        dinosaur | Repeat 2 | Gm 3,
        Overlay [
            birds | Gm 5,
            bass,
        ]
    ]
    | Repeat 8
}
