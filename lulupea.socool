{ f: 311.127, l: 1, g: 1/3, p: 0 }

bd = {
    Overlay [
        { 5/4, 0, 1/5, -1/8 },
        { 5/4, -11, 1/5, 1/8 },
        { 1/2, 1, 1/2, -3/4 },
        { 1/2, 0, 1/2, 3/4 },
        { 3/4, 0, 1/8, -1/4 },
        { 3/4, -3, 1/8, 1/4 },
        { 1/4, 0, 1, 3/4 },
        { 1/4, -4, 1, -3/4 },
    ]
    | Kick {
        body: 0.85,
        pitch_decay: 0.025,
        pitch_range: 0.3,
        amp_decay: 0.45,
        click_amount: 0.2,
        saturation: 0.85,
        hump: 4.85,
        shell: 0.4,
        ks_mix: 0.25
    }
    | Gm 3/2
}

hh = {
    Overlay [
        { 3/1, 0, 1/6, -1/8 },
        { 3/1, -7, 1/6, 1/8 },
        { 3/1, 0, 1/6, -1/2 },
        { 3/1, -3, 1/6, 1/2 },
        { 1/1, 1, 1/2, -3/4 },
        { 1/1, 0, 1/2, 3/4 },
    ]
    | HiHat {
        metal: 0.75,
        decay_rate: 50,
        brightness: 0.15,
        pitch_drop: 0.08,
        ping_amount: 0.42
    }
    | Gm 2/8
}

sn = {
    Overlay [
        { 1/1, 1, 1/2, -3/4 },
        { 1/1, 0, 1/2, 3/4 },
        { 3/4, 0, 1/8, -1/4 },
        { 3/4, -3, 1/8, 1/4 },
    ]
    | Snare {
        attack: 0.72,
        wires: 0.55,
        tone: 0.6,
        length: 0.42,
        saturation: 0.25
    }
    | Fm 5/4
    | Gm 3/2
}

x = { Gm 0 }

thing1 = {
    Overlay [
        { 2/1, 2, 1, 1/5 },
        { 2/1, 0, 1, -1/5 },
        { 3/2, 2, 1, 1 },
        { 3/2, 0, 1, -1 },
        { 4/3, 3, 1, 1/3 },
        { 4/3, 0, 1, -1/3 },
        { 1/1, 4, 1, 1 },
        { 1/1, 0, 1, -1 },
        { 1/2, 2, 1, 1 },
        { 1/2, 0, 1, -1 },
    ]
    | Overlay [
        Seq [Fm 1, Fm 0, Fm 0] | Lm 1/3,
        Fm 0
    ]
    | Seq [
        Fm 4/3, Fm 3/2, Fm 1,
        Fm 5/6, Fm 3/2, Fm 1,
        Fm 15/16, Fm 3/2, Fm 1,
        Fm 9/8, Fm 3/2, Fm 1,
        Fm 5/6, Fm 3/4,
        Fm 3/2, Fm 3/2, Fm 1,
        Fm 3/2, Fm 3/2, Fm 1,
        Fm 7/4, Fm 5/3, Fm 1,
        Fm 3/2, Fm 3/2, Fm 1,
    ]
    | Color [firebrick, white, grey, black, black, black] | Gradient(0, 1, 0)
    | wgsl {
        Seq [
            Direction (0, 0, -1);
        ];
    }
    | Overlay [
        Fm 1,
    ]
    | Repeat 3
}

thing2 = {
    Overlay [
        { 2/1, 3, 1, 1/4 },
        { 2/1, 0, 1, -1/6 },
        { 3/2, 2, 1, 1/6 },
        { 3/2, 0, 1, -1/4 },
    ]
    | Seq [
        Fm 3/4, Fm 5/4, Fm 3/2, Fm 9/8,
    ]
    | FitLength thing1
    | Color [blue, grey, black, black, black] | Gradient(0, 1, 0)
    | wgsl {
        Seq [
            Direction (0, -0.2, -1) | Lm 8;
        ];
    }
}

thing3 = {
    Overlay [
        { 2, 4, 1, 1/2 },
        { 2, 0, 1, -1/3 },
        { 3/2, 4, 1, 1/3 },
        { 3/2, 0, 1, -1/2 },
        { 1/1, 3, 1, 2/3 },
        { 1/1, 0, 1, -2/3 },
    ]
    | Seq [
        Fm 5/4, Fm 5/6, Fm 1, Fm 15/16, Fm 5/6, Fm 3/2
    ]
    | wgsl {
        Seq [
            Direction (0, -0.2, -1) | Lm 8;
        ];
    }
    | FitLength thing1
    | Color [yellow, grey, black, black, black] | Gradient(0, 1, 0)
}

thing4 = {
    Overlay [
        { 2, 7, 1/3, 1/8 },
        { 2, 0, 1/3, -1/8 },
        { 3/4, 6, 1, 1/2 },
        { 3/4, 0, 1, -1/2 },
        { 1/2, 0.1, 1, 1/2 },
        { 1/2, 0, 1, -1/2 },
        { 1/4, 0.5, 1, 1/2 },
        { 1/4, 0, 1, -1/2 },
    ]
    | Seq [Lm 7, Fm 0, Fm 0]
    | Seq [
        Fm 1, Fm 5/6, Fm 5/8, Fm 2/3,
    ]
    | wgsl {
        Seq [
            Direction (0, -0.2, -1) | Lm 8;
        ];
    }
    | FitLength thing1
    | Color [white, grey] | Gradient(0, 1, 0)
}

hihat = {
    Seq [
        hh
        | Seq [Fm 4, Fm 0, Fm 0, Fm 1/2, Fm 0, Fm 4, Fm 0, Fm 1, Fm 1, Fm 0, Fm 0, Fm 1] | Seq [AsIs, Reverse]
        | Overlay [Repeat 3]
    ] | FitLength thing1
}

drums = {
    Overlay [
        { 1/1, 0.5, 1, 1/2 },
        { 1/1, 0, 1, -1/2 },
        { 1/2, 0.1, 1, 1/2 },
        { 1/2, 0, 1, -1/2 },
    ]
    | Overlay [
        bd | Seq [Repeat 4, Fm 2, Repeat 2, Fm 7/4, Repeat 9, Fm 2 | Lm 1/2 | Repeat 2, Fm 7/4, Repeat 5]
        | FitLength thing1,
    ] | Gm 1/2
    | wgsl {
        Seq [
            Direction (0, 0.3, -1) | Lm 8;
        ];
    }
}

main = {
    Overlay [
        -- drums,
        thing4,
        thing1
        | ModBy [
            Seq [Repeat 5, Overlay [Fm 1, Fa -3] | Gm 1/2 | Pm 1/2]
        ],
        Overlay [
            thing2,
            thing3,
        ]
        | ModBy [
            Seq [Fm 1, Fm 0, Fm 1, Fm 0, Fm 0, Fm 1] | Repeat 8
        ]
    ]
    | Lm 1/6
    | Repeat 2
}
