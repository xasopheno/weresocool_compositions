{ f: 311.127, l: 1, g: 1/4, p: 0 }

walls = {
    Overlay [
        FromSound(50, 10) ./snare.mp3
    ]
    | ModBy [$a, Lm 2] -> [a]
    | ModBy [
        Seq [
            Fm 1, Fm 4/3, Fm 1, Fm 4/5
        ] | Repeat 8
    ]
    | Overlay [
        { 1/1, 2, 1, 1 },
        { 1/1, 0, 1, -1 },
        { 1/2, 2, 1, 1 },
        { 1/2, 0, 1, -1 },
        { 1/4, 2, 1, 1 },
        { 1/4, 0, 1, -1 },
        { 1/8, 2, 1/4, 1 },
        { 1/8, 0, 1/4, -1 },
    ]
    | Gm 1/2
    | Lm 4
}

birds = {
    Overlay [
        FromSound(50, 10) ./bird.mp3
    ]
    | Gm 2
    | ModBy [Lm 1, $a, Lm 2] -> [a]
    | Overlay [
        { 1/1, 2, 1, 1/10 },
        { 1/1, 0, 1, -1/10 },
        { 1/2, 2, 1, 1/11 },
        { 1/2, 0, 1, -1/11 },
        { 1/4, 2, 1, 1/12 },
        { 1/4, 0, 1, -1/12 },
    ]
    | Lm 1
}

thing1 = {
    Seq [
        walls,
    ]
    | Repeat 5
    | Color [firebrick, white, grey, black, black, black] | Gradient(0, 1, 0)
    | wgsl {
        Sm "scale * 3.0 * (1 - Time) * 3.0";
        Seq [
            Direction (0, 0, -1);
        ];
    }
}

thing2 = {
    Overlay [
        { 11/4, 3, 1, 1/5 },
        { 11/4, 0, 1, -1/5 },
        { 1/1, 5, 1, 1/6 },
        { 1/1, 0, 1, -1/6 },
        { 7/12, 2, 1, 1/8 },
        { 7/12, 0, 1, -1/8 },
        { 1/2, 0.2, 1, 1/6 },
        { 1/2, 0, 1, -1/6 },
        { 1/4, 0.2, 1, 1/6 },
        { 1/4, 0, 1, -1/6 },
    ]
    | Gm 1/2
    | FitLength thing1
    | Color [blue, grey, black, black, black] | Gradient(0, 1, 0)
    | wgsl {
        Ya -0.3;
        Sm 3;
        Seq [
            Direction (x * Time * 0.05, -0.2, -1) | Lm 4;
        ];
    }
    | ModBy [Lm 5, Fm 2/3]
}

thing3 = {
    birds
    | Gm 2
    | Color [green, grey, black, black, black] | Gradient(0, 1, 0)
    | Overlay [
        wgsl {
            Xm "scale * 1.0 * (1 - Time) * 3.0";
            Sm 1.1;
            Xm 1/10;
            Seq [
                -- Direction (x * time, 0.05, -1) | Lm 4 | Ym "y - sin(time) * 0.3";
                Direction (x * Time, 0.05, -1) | Lm 5;
                Sm 0;
            ];
        },
    ]
    | Repeat 5
    | FitLength thing1
}

bass = {
    Overlay [
        { 10/3, 2, 1, 1 },
        { 10/3, 0, 1, -1 },
        { 9/4, 2, 1, 1 },
        { 9/4, 0, 1, -1 },
        { 3/4, 2, 1, 1 },
        { 3/4, 0, 1, -1 },
        { 1/2, 2, 1, 1 },
        { 1/2, 0, 1, -1 },
    ]
    | Overlay [
        { 1/1, 2, 1, 1 },
        { 1/1, 0, 1, -1 },
        { 3/4, 2, 1, 1 },
        { 3/4, 0, 1, -1 },
        { 1/2, 2, 1, 1 },
        { 1/2, 0, 1, -1 },
    ]
    | Gm 1/2
    | Seq [
        Fm 3 | Lm 2,
        Fm 0 | Lm 5,
        Fm 11/4 | Lm 2,
        Fm 0 | Lm 5,
        Fm 1/4,
        Fm 0 | Lm 5,
    ]
    | wgsl {
        Sm 2.1;
        Xm 1/10;
        Seq [
            Direction (x * Time, 0.001, -1) | Lm 4;
        ];
    }
    | Color [brightgreen, purple, grey, black, black, black] | Gradient(0, 1, 0)
    | FitLength thing1
}

main = {
    Overlay [
        thing1 | #a,
        thing2 | #b,
        thing3 | #c,
        bass,
    ]
    | Repeat 2
} -> [a, b, c]
