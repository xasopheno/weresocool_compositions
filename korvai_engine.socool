{ f: 82, l: 1/8, g: 1, p: 0 }

-- Korvai engine: Carnatic rhythm math on a drum synth.
-- Adi tala, 8 beats, counted here as a 32-pulse cycle.
--   1. sarvalaghu: the accompaniment groove in 16ths (chatusra)
--   2. tisra gati: the SAME beat, subdivision flips to 3s
--      (24 events x Lm 4/3 = one exact cycle)
--   3. khanda gati: subdivision flips to 5s
--      (40 events x Lm 4/5 = one exact cycle)
--   4. tihai: an 8-pulse phrase stated three times with 4-pulse gaps
--      (8+4+8+4+8 = 32) — the third statement slams into sam
--   5. payoff: half-time JD groove with khanda hats floating on top
--
-- Play: weresocool play korvai_engine.socool

x = { Silence 1 }

-- mridangam-ish voices
th = { Kick acoustic | Fm 3/4 | Gm 0.95 }
dh = { Tom acoustic | Gm 0.65 }
nm = { Rimshot acoustic | Gm 0.6 | Pa 1/5 }
ka = { Snare snap | Gm 0.45 | Pa -1/5 }
kj = { Shaker tambourine | Gm 0.35 | Pa 1/3 }

-- kit for the payoff
bd = { Kick 808 | Gm 0.95 }
sn = { Snare wsc | Gm 0.85 }
h8 = { Shaker 808 | Gm 0.3 | Pa -1/4 }

-- ── sarvalaghu (32 pulses, chatusra) ────────────────────────────────
sarva = {
    Seq [
        th, x, nm, x,   ka, nm, x, nm,
        th, x, nm, ka,   nm, x, ka, x,
        th, x, nm, x,   ka, nm, x, nm,
        th, ka, nm, x,   th, x, nm, nm
    ]
}

sarva_b = {
    Seq [
        th, x, nm, x,   ka, nm, x, nm,
        th, x, nm, ka,   nm, ka | Lm 1/2 | Repeat 2, ka, x,
        th, x, nm, ka,   ka, nm, x, nm,
        th, ka, nm | Lm 1/2 | Repeat 2, nm,   th, x, dh, x
    ]
}

kanjira = {
    Seq [kj, x, kj | Gm 0.5, x] | Repeat 8
}

-- ── tisra gati: 24 threes in the same cycle ─────────────────────────
tisra = {
    Seq [
        th, nm, ka,   dh, nm, ka,   th, nm, ka,   nm, dh, ka,
        th, x, ka,    dh, x, ka,    th, nm, ka,   th, dh, x
    ] | Lm 4/3
}

-- ── khanda gati: 40 fives in the same cycle ─────────────────────────
khanda = {
    Seq [
        th, ka, nm, ka, nm,   dh, ka, nm, ka, x,
        th, ka, nm, ka, nm,   dh, x, ka, nm, x,
        th, ka, nm, ka, nm,   dh, ka, nm, ka, x,
        th, ka, dh, ka, nm,   th, x, dh, x, x
    ] | Lm 4/5
}

-- ── tihai: phrase x3, gaps between, lands on sam ────────────────────
phrase = {
    Seq [nm, ka, dh, nm,   x, th, x, th | Gm 1.2]
}

tihai = {
    Seq [
        phrase, x | Lm 4,
        phrase, x | Lm 4,
        phrase
    ]
}

-- ── payoff: half-time with khanda hats floating over ────────────────
halftime = {
    Overlay [
        Seq [
            bd, x, x, x,   x, x, x, x,
            x, x, bd | Gm 0.6, x,   x, x, x, x,
            x, sn, x, x,   x, x, x, bd | Gm 0.7,
            x, x, x, x,   x, sn | Gm 0.3, x, x
        ],
        Seq [
            h8 | Gm 2, h8, h8, h8, h8,
            h8 | Gm 2, h8, h8, h8, h8,
            h8 | Gm 2, h8, h8, h8, h8,
            h8 | Gm 2, h8, h8, h8, h8,
            h8 | Gm 2, h8, h8, h8, h8,
            h8 | Gm 2, h8, h8, h8, h8,
            h8 | Gm 2, h8, h8, h8, h8,
            h8 | Gm 2, h8, h8, h8, h8
        ] | Lm 4/5
    ]
}

sam = { Overlay [th | Gm 1.3 | Lm 4, bd | Lm 4, kj | Lm 4] }

main = {
    Seq [
        Overlay [sarva, kanjira],
        Overlay [sarva_b, kanjira],
        Overlay [tisra, kanjira],
        Overlay [khanda, kanjira],
        tihai,
        Seq [sam, x | Lm 28],
        halftime,
        halftime,
        Overlay [tihai, halftime],
        sam
    ]
}
