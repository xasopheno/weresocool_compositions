{ f: 65, l: 1/10, g: 1, p: 0, w: 1.6, h: 0.9, background_color: #05060c }

-- THE GAME, PLAYED IN A ROSE WINDOW.
--
-- Same dice, same music as glitch_choose — but the table is gone.
-- Everything now lands on RINGS around a centre the marks never touch:
-- the eye of the window stays open, and the piece assembles itself
-- around that absence. Placement is radial — a note's index walks an
-- angle around the ring, its row chooses which ring — and every mark
-- is doubled across the vertical axis, because a rose window is
-- bilateral before it is anything else.
--
-- The medium is GLASS, not paper: pigment here is what the light comes
-- THROUGH, and a raking light reads the piled-up lead of the game as
-- relief. One harmony across all five voices, the old window-makers'
-- chord: sunset glass, lapis, ruby, pale gold light, violet.
--
--   kick  → PIPS: sunset roundels — yellow through orange to purple
--   blip  → ARCS: lapis tracery sweeping between rings
--   snare → COILS: ruby rosettes that unroll where the throw lands
--   hats  → FLECKS: pale gold light scattered through the outer halo
--   clap  → SPOKES: violet mullions cutting outward from the eye
--
-- Sun through glass: a warm gold key high and left, moonlight rim from
-- behind the window, deep indigo ambient for the stone.
light key = { from: (-1.2, 1.1, 0.6), color: #ffd9a0, gain: 1.0 }
light rim = { from: (0.9, -0.3, -1.5), color: #8fb8ff, gain: 0.70 }
light air = { ambient, color: #1c2440, gain: 0.60 }

-- ── THE WET LAYER ───────────────────────────────────────────────────
-- Marks accumulate here and only here. `Lay` keeps the paint in the
-- state buffer verbatim; `cap` is the only limiter, so piled-up
-- passages keep their hue instead of drifting as they saturate.
warp wet = {
    Prev
    | Lay { keep: 0.9880, gain: 1.0, cap: 6.0 }
    | Diffuse Sxyz { rate: 0.115 }
    | Diffuse Sw { rate: 0.115 }
}

-- ── THE WINDOW ──────────────────────────────────────────────────────
-- Glass, not paper — the pigment is what the light comes through.
-- The raking light comes AFTER the paint (Paint writes color
-- wholesale; anything upstream of it is discarded), and it reads the
-- coverage the game has piled up as leading standing off the pane.
warp canvas = {
    Scene
    | Paint(glass)
    | Raking { from: Sw, light: key, depth: 14.0 }
}

-- ── THE SHAPES ──────────────────────────────────────────────────────
-- Every figure is the same three steps: Spawn a trail, drive x and y
-- from Stroke, run the weight down. Placement is RADIAL: the note's
-- index walks an angle around the ring (by a step that never divides
-- evenly, so the ring fills without repeating), its row picks the
-- ring. Nothing lands at the centre — the eye stays open. And every
-- mark is doubled with Mirror(X): the window is bilateral.

-- kick: a sunset roundel set into the inner rings
draw pip = {
    let a = Count * 0.8976
    let m = Wrap(floor(Count / 7.0), 4.0)
    let ring = 0.34 + m * 0.13
    let depth = 0.0 - 0.15 - m * 0.40
    let cx = sin(a) * ring * 1.45
    let cy = cos(a) * ring * 0.82
    let r = 0.16 + Note.z * 0.12

    Point
    | Spawn { n: 9, by: Sm(0.86) }
    | Spawn { n: 46, by: Sm(1.0) }
        | Xa(sin(Stroke * 6.28318) * r)
        | Ya(cos(Stroke * 6.28318) * r * 2.0)
    | Jitter(0.0009)
    | Gradient
    | Warm(0.42 - 0.09 * m)
    | Xf(cx)
    | Overlay [
        Yf(cy),
        Mirror(X) | Yf(cy),
      ]
    | Tint(1.0, 0.98, 0.94, 0.80)
}

-- blip: lapis tracery — an arc swung between the rings, riding the
-- rim light because it is the voice that moves toward you
draw orbital = {
    let a = Count * 1.2566
    let m = Wrap(floor(Count / 5.0), 4.0)
    let dir = 0.0 - 1.0 + 2.0 * floor(m / 2.0)
    let ring = 0.42 + m * 0.11
    let depth = 0.0 - 0.20 - m * 0.50
    let ax = sin(a) * ring * 1.45
    let ay = cos(a) * ring * 0.82
    let sweep = 0.40 + Note.z * 0.45

    Point
    | Spawn { n: 190, by: Sm(0.9990) }
        | Xa(sin(Stroke * 1.9 + 0.3) * sweep * dir)
        | Ya(cos(Stroke * 1.9 + 0.3) * sweep * 1.6 * dir)
        | Za(depth + sin(Stroke * 3.14159) * 0.10)
    | Spawn { n: 3, by: Ya(0.004) }
    | Jitter(0.0008)
    | Gradient(rim)
    | Cool(0.20 + 0.09 * m)
    | Xf(ax)
    | Overlay [
        Yf(ay),
        Mirror(X) | Yf(ay),
      ]
    | Tint(0.94, 0.97, 1.0, 0.30)
}

-- snare: a ruby rosette — the spiral unrolls at one of eight petal
-- stations; Stagger lays the coil in order, so the hit draws itself
draw coil = {
    let a = Wrap(Count, 8.0) * 0.7854
    let m = Wrap(floor(Count / 8.0), 3.0)
    let dir = 0.0 - 1.0 + 2.0 * floor(m / 2.0)
    let ring = 0.52 + m * 0.10
    let depth = 0.0 - 0.10 - m * 0.46
    let sx = sin(a) * ring * 1.45
    let sy = cos(a) * ring * 0.82
    let turns = 2.6 + Note.z * 1.6
    let reach = (0.10 + Note.z * 0.14) * (1.4 - 0.20 * m)

    Point
    | Spawn { n: 620, by: Sm(0.9990) }
        | Xa(cos(Stroke * 6.28318 * turns) * reach * Stroke * dir)
        | Ya(sin(Stroke * 6.28318 * turns) * reach * Stroke * 2.0)
        | Za(depth + Stroke * 0.22)
    | Jitter(0.0007)
    | Stagger { over: 0.60 }
    | Gradient
    | Xf(sx)
    | Overlay [
        Yf(sy),
        Mirror(X) | Yf(sy),
      ]
    | Tint(1.0, 0.97, 0.96, 0.45)
}

-- hats: pale gold light scattered through the outer halo — the angle
-- steps by the golden angle, so the halo fills like a seed head
draw fleck = {
    let a = Count * 2.39996
    let m = Wrap(floor(Count / 9.0), 5.0)
    let dir = 0.0 - 1.0 + 2.0 * floor(m / 3.0)
    let ring = 0.60 + m * 0.075
    let depth = 0.0 - 0.05 - m * 0.30
    let px = sin(a) * ring * 1.45
    let py = cos(a) * ring * 0.82
    let r = 0.012 + Note.z * 0.010

    Point
    | Spawn { n: 5, by: Sm(0.84) | Xa(0.006 * dir) }
    | Spawn { n: 22, by: Sm(1.0) }
        | Xa(sin(Stroke * 6.28318) * r * dir)
        | Ya(cos(Stroke * 6.28318) * r * 2.0)
    | Jitter(0.0005)
    | Gradient
    | Warm(0.50 - 0.06 * m)
    | Xf(px)
    | Overlay [
        Yf(py),
        Mirror(X) | Yf(py),
      ]
    | Tint(1.0, 0.94, 0.92, 0.40)
}

-- clap: a violet mullion — a spoke cutting outward from the eye,
-- running from the inner ring to the halo along its own angle
draw slash = {
    let k = Wrap(Count, 6.0)
    let a = k * 1.0472 + 0.5236
    let m = Wrap(floor(Count / 6.0), 4.0)
    let depth = 0.0 - 0.12 - m * 0.40
    let len = 0.30 + Note.z * 0.25

    Point
    | Spawn { n: 240, by: Sm(0.9992) }
        | Xa(sin(a) * (0.30 + Stroke * len) * 1.45)
        | Ya(cos(a) * (0.30 + Stroke * len) * 0.82)
        | Za(depth)
    | Jitter(0.0008)
    | Gradient
    | Cool(0.16 + 0.07 * m)
    | Overlay [
        Yf(0.0),
        Mirror(X) | Yf(0.0),
      ]
    | Tint(0.96, 0.94, 1.0, 0.36)
}

x = { Silence 1 }

bd = {
    -- eight detuned voices around the fundamental: a wide sub pair at
    -- the bottom, a mid pair for the shell, upper partials for the
    -- knock — then a fully-dialed kick instead of the flat 909 preset
    Overlay [
        { 5/1, 0, 1/5, -1/8 },
        { 5/1, -11, 1/5, 1/8 },
        { 2/1, 1, 1/2, -3/4 },
        { 2/1, 0, 1/2, 3/4 },
        { 3/1, 0, 1/8, -1/4 },
        { 3/1, -3, 1/8, 1/4 },
        { 1/1, 0, 1, 3/4 },
        { 1/1, -4, 1, -3/4 },
    ]
    | Kick {
        body: 0.85,
        pitch_decay: 0.025,
        pitch_range: 0.3,
        amp_decay: 0.45,
        click_amount: 0.2,
        saturation: 0.85,
        hump: 4.85,
        shell: 0.4,
        ks_mix: 0.25
    }
    | Gm 1
    -- SUNSET: many colors, ordered as one temperature ramp — pale
    -- yellow through hard orange and rose down to deep purple. The
    -- gradient runs across every roundel, so each kick wears the whole
    -- sky instead of picking one pane.
    | Color [#fff9c4, #ffd54f, #ff9e2e, #e05270, #8e3fa8, #451d6b]
    | wgsl {
        // THE PRESS: a pip lands narrow and heavy, spreads under the
        // weight, and thins where it came away.
        // bigger and brighter than the paper version: on glass the
        // kick has to burn through, not sit on the surface
        Sm 0.034;
        Smx "0.32";
        Smy "2.2";
        Ry "Clock * 0.010";
        SwingZ "0.72 - 1.44 * (note_event - 2.0 * floor(note_event / 2.0))";
        Shade key;
        Vm 0.0; Die 0.77;
        Bm "(2.6 + Rand(3) * 0.9) * (0.90 + 2.20 * exp(0.0 - Time * 6.0))";
        Bm Slew(0.55, 2.2);

        // the palette carries the color now, so the press curve stays
        // neutral: fresh marks flare bright, loaded ones settle dark
        let press = exp(0.0 - Time * 4.0);
        red   = red   * (1.20 - 0.20 * press);
        green = green * (1.20 - 0.20 * press);
        blue  = blue  * (1.20 - 0.20 * press);
    }
    | pip
    | wet
    | canvas
}

sn = {
    Snare 909 | Gm 0.7
    -- ruby glass: rose at the surface, garnet where it thickens
    | Color [#fff0f0, #ffc4c4, #f28080, #cc4444, #8a1f1f, #470c0c]
    | wgsl {
        // THE STRIKE FLARES: it arrives longer and thicker and settles
        // back inside a few frames — Time is the mark's own age.
        Sm "0.0085 * (1.0 + 2.20 * exp(0.0 - Time * 3.0))";
        Smx "0.20 * (1.0 + 1.40 * exp(0.0 - Time * 3.5))";
        Smy "1.7 * (1.0 + 1.10 * exp(0.0 - Time * 3.0))";
        Ry "Clock * 0.010";
        SwingZ "1.02 - 2.04 * (note_event - 2.0 * floor(note_event / 2.0))";
        Vm 0.0; Die 0.77;
        Bm "(1.35 + Rand(5) * 0.85) * (0.95 + 5.50 * exp(0.0 - Time * 3.2))";
        Bm Slew(0.42, 2.6);

        // green falling carries orange to red; blue rising late is the
        // crimson coming up underneath
        let strike = exp(0.0 - Time * 3.4);
        red   = red   * (1.00 + 0.50 * strike);
        green = green * (0.55 + 1.15 * strike);
        blue  = blue  * (0.70 + 0.55 * (1.0 - strike));
    }
    | coil
    | wet
    | canvas
}

hh = {
    HiHat 909 | Gm 0.25 | Pa 1/4
    -- pale gold light: the halo's small panes, whitest where freshest
    | Color [#fffdf4, #fdf3cc, #f2e19a, #d9bf62, #a68a33, #594a14]
    | wgsl {
        // A BURST: big for an instant, then it holds as a speck. On a
        // white ground brightness buys density, not glow.
        Sm "(0.55 + Rand(21) * 0.45) * (0.9 + 1.2 * exp(0.0 - Time * 6.0))";
        Smy "0.9 + 0.3 * Rand(22)";
        Smx "0.9 + 0.3 * Rand(23)";
        Ry "Clock * 0.010";
        SwingZ "Rand(24) * 3.14159";
        Bm "0.9 + 0.8 * exp(0.0 - Time * 6.0)";
        Vm 0.0; Va "0.0 - 0.32"; Die 0.84;

        // lands dense gold, thins toward viridian as it ages
        let fresh = exp(0.0 - Time * 5.0);
        red = red * (1.0 + 0.35 * fresh);
        green = green * (0.85 + 0.25 * fresh);
        blue = blue * (0.88 + 0.20 * fresh);
    }
    | fleck
    | wet
    | canvas
}

oh = {
    OpenHat 909 | Gm 0.35 | Pa 1/4
    | Color [#fffdf4, #fdf3cc, #f2e19a, #d9bf62, #a68a33, #594a14]
    | wgsl {
        // the open hat is the same chaff, wider and slower to settle
        Sm "(0.85 + Rand(31) * 0.55) * (0.9 + 1.2 * exp(0.0 - Time * 4.0))";
        Smy "0.9 + 0.3 * Rand(32)";
        Smx "0.9 + 0.3 * Rand(33)";
        Ry "Clock * 0.010";
        SwingZ "Rand(34) * 3.14159";
        Bm "0.9 + 0.8 * exp(0.0 - Time * 4.0)";
        Vm 0.0; Va "0.0 - 0.32"; Die 0.84;

        let fresh = exp(0.0 - Time * 3.5);
        red = red * (1.0 + 0.35 * fresh);
        green = green * (0.85 + 0.25 * fresh);
        blue = blue * (0.88 + 0.20 * fresh);
    }
    | fleck
    | wet
    | canvas
}

cp = {
    Clap 909 | Gm 0.6
    -- the tally: violet, loaded to near-black where the stroke bites
    | Color [#f6f2fa, #d5c4e8, #a888cc, #7355a4, #47316f, #251642]
    | wgsl {
        // one fast cut — thin, hard, over in a moment
        Sm "0.0080 * (1.0 + 1.80 * exp(0.0 - Time * 4.0))";
        Smx "0.16";
        Smy "2.4";
        Ry "Clock * 0.010";
        SwingZ "0.60 - 1.20 * (note_event - 2.0 * floor(note_event / 2.0))";
        Vm 0.0; Die 0.77;
        Bm "(1.10 + Rand(41) * 0.70) * (0.95 + 3.50 * exp(0.0 - Time * 3.5))";
        Bm Slew(0.45, 2.4);

        let bite = exp(0.0 - Time * 3.8);
        red   = red   * (0.85 + 0.35 * bite);
        green = green * (0.75 + 0.30 * bite);
        blue  = blue  * (1.00 + 0.25 * bite);
    }
    | slash
    | wet
    | canvas
}

bl = {
    Tom glass | Fm 2 | Gm 0.4
    -- cobalt through ultramarine: a ramp of HOW MUCH PAINT, wash to
    -- load — the lit shoulder is written darkest because pigment
    -- subtracts
    | Color [#f4fbff, #b9e0f2, #6bb4d8, #2f7cae, #17497e, #0a2247]
    | wgsl {
        // A BROAD FLAT BRUSH, LOADED, RUNNING DRY: the head of the
        // stroke is wet and wide, the tail is a dry liner.
        Sm 0.030;
        Smx "0.30";
        Smy "2.6";
        Ry "Clock * 0.010";
        SwingZ "0.0";
        Shade rim;
        Vm 0.0; Die 0.77;
        Bm "(0.62 + Rand(7) * 0.40) * (0.85 + 1.05 * exp(0.0 - Time * 1.8))";
        Bm Slew(0.50, 1.1);

        // wet ultramarine is deep and slightly violet; as the water
        // goes it lightens toward cerulean
        let wet = exp(0.0 - Time * 1.5);
        red   = red   * (0.72 + 0.55 * wet);
        green = green * (0.86 + 0.30 * wet);
        blue  = blue  * (0.94 + 0.22 * wet);
    }
    | orbital
    | wet
    | canvas
}

rs = {
    Rimshot 909 | Gm 0.45 | Pa -1/3
    | Color [#fff0f0, #ffc4c4, #f28080, #cc4444, #8a1f1f, #470c0c]
    | wgsl {
        // the rim click is a small pane of the snare's ruby
        Sm "(0.45 + Rand(51) * 0.30) * (0.9 + 1.0 * exp(0.0 - Time * 6.0))";
        Smy "0.9 + 0.3 * Rand(52)";
        Smx "0.9 + 0.3 * Rand(53)";
        Ry "Clock * 0.010";
        SwingZ "Rand(54) * 3.14159";
        Bm "0.9 + 0.7 * exp(0.0 - Time * 6.0)";
        Vm 0.0; Die 0.84;

        let fresh = exp(0.0 - Time * 5.0);
        red = red * (1.0 + 0.30 * fresh);
        green = green * (0.80 + 0.25 * fresh);
        blue = blue * (0.85 + 0.15 * fresh);
    }
    | fleck
    | wet
    | canvas
}

anchor = {
    Seq [
        bd, x, x, bd | Gm 0.6, x, x, bd, x,
        x, x, bd | Gm 0.7, x, x, bd | Gm 0.5, x, x
    ]
}

backbeat = {
    Seq [
        x, x, x, x, cp, x, x, x,
        x, x, x, x, cp, x, x, x
    ]
}

hat_dice = {
    Choose [
        hh,
        hh | Gm 0.4,
        hh | Lm 1/2 | Repeat 2,
        hh | Lm 1/4 | Repeat 4 | Gm 0.5,
        oh | Gm 0.7,
        x
    ] | Repeat 16
}

snare_dice = {
    Choose [
        x,
        x,
        sn | Gm 0.4,
        sn | Lm 1/2 | Repeat 2 | Gm 0.5,
        sn | Fm 9/8 | Lm 1/3 | Repeat 3 | Gm 0.5,
        sn | Fm 6/5 | Lm 1/4 | Repeat 4 | Gm 0.6,
        sn | Bitcrusher(4, 1, 0.7) | Gm 0.5,
        sn | Overdrive(4, 0.4) | Lm 1/2 | Repeat 2 | Gm 0.5,
        rs | Gm 0.8
    ] | Repeat 16
}

blip_dice = {
    Choose [
        x,
        x,
        x,
        x, 
        bl | Fm 3/4,
        bl | Fm 5/6,
        bl | Fm 5/4,
        bl | Fm 4/3,
    ] 
    | Overlay [
        -- {3, 3, 1/7, 1},
        -- {3, 0, 1/7, -1},
        -- {5/3, 3, 1/14, 1},
        -- {4/3, 0, 1/14, -1},
        -- {5/4, 3, 1/14, 1},
        -- {9/8, 0, 1/14, -1},
        {1/2, -1, 1, 1/2},
        {1/2, 0, 1, -1/2},
    ]
    | Repeat 16
}

lock = { Overlay [anchor, backbeat, hat_dice] }

full = { Overlay [anchor, backbeat, hat_dice, snare_dice, blip_dice] }

free = { Overlay [hat_dice, snare_dice, blip_dice] }

main = {
    Seq [
        --   anchor,
        lock | Reverse | Fm 3/2,
        lock | Fm 7/4,
        full,
        full,
        full,
        free,
        free | Fm 6/5,
        full,
        full | Fm 6/5,
        full,
       -- Overlay [bd | Lm 6, cp | Lm 6, oh | Lm 6]
    ]
    | Repeat 3
} -> [bd, sn, hh, bl]
