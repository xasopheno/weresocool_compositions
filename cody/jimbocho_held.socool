{ f: 311.127, l: 1, g: 1/8, p: 0, rand_seed: 42, background_color: #05060c }

-- THE FRAME IS PART OF THE PIECE.
--
-- Until this block existed the viewpoint came from `jimbocho_held.socool.json`,
-- saved by flying around in watch. The cut and the full song each had their own
-- json and they had drifted apart — one at y 0.399, one at y 0.0 — so the file
-- being tuned and the file being rendered were not framed alike, and both were
-- saved in a 1728x1051 window then printed at 16:9, showing more width than
-- either was ever framed for. Declaring it here outranks both, and print,
-- watch and every future render agree.
--
-- `look` is the content's own plane, z -2.10, not the origin: the whole bundle
-- sits back there and aiming at 0 aims in front of it.
camera main = { from: (0, 0, 0.62), look: (0, 0, -2.10), fov: 60 }

-- JIMBOCHO / HELD — the multitrack as a deep space.
--
-- Same ten stems, same twelve bars (see make_stems.sh), same FromSound
-- analysis. What changes is the MEDIUM.
--
-- jimbocho_impasto.socool is a polyptych: ten flat panels, one per stem, read
-- left to right. This one is after AL HELD's late polychrome — Solar Wind,
-- Vorces, the big acrylics of the eighties. Held's canvases are hard-edge
-- geometric SOLIDS suspended in an impossible perspectival space: open cubes,
-- receding frames, cones, tori, grids laid into depth, every edge crisp,
-- every solid transparent. There is no atmosphere in a Held and nothing is
-- blurred. What makes the space is not haze, it is OCCLUSION and SCALE — a
-- near cube covers a far one, and you read the distance from the covering.
--
-- The colour is not Held's, though. It is eighties Japanese graphic — city
-- pop sleeves, Eizin Suzuki, Hiroshi Nagai: flat saturated coral and
-- turquoise and cream against a deep twilight blue, no black, no grit,
-- everything clean. Held's structures in Suzuki's light.
--
-- BETWEEN THE POLYPTYCH AND THE SCATTER. The first cut of this piece threw
-- every solid at a random point on the canvas, and ten stems each throwing
-- solids anywhere is a heap — a heap has no parts, and you could not follow
-- one instrument through it. Each stem now walks its OWN PATH: a vector, an
-- arc, a helix, a circle, parameterised by `Time`, the note's composition
-- time in seconds. The structures are beads on ten different wires. You can
-- follow a part again, the way you could in the polyptych, and it is still
-- one deep space rather than ten panels.

-- ─── space: the far field, the only chain that remembers ─────────────────
-- ── THE GROUND ──────────────────────────────────────────────────────────
-- The void, written as a SURFACE rather than as an absence. A canvas def is
-- authorable in the piece, so this is not one of the library papers with the
-- lights turned down — it is a ground built to be nothing and still be
-- something: near-black, but with a weave four times finer than linen's and a
-- tooth that breaks a fill just enough that a flat passage is never flat.
--
-- Two things make it read as depth rather than as paper painted black. On a
-- dark ground absorption has almost nothing left to take, so `density` drops
-- to 2.6 and the marks read by what they RETURN instead of what they stop.
-- And `absorb.black: 1.0` — coverage as an independent witness that pigment
-- is present — is what lets a dark mark be a dark mark here at all, since on
-- a subtractive surface "how much paint" is max(r,g,b) and #000000 has none.
--
-- `sheen.knee` is the one number that must not be guessed: it is in the same
-- units as `Lay`'s `cap`, and the library's knees assume a cap near 5. This
-- piece caps at 1.7, so a knee copied from linen would sit three times above
-- anything the paint can reach and no passage would ever catch the light.
canvas void = {
    ground: #05060c,
    weave: { scale: 900, depth: 0.014, slub: 150 },
    tooth: 0.04,
    absorb: { density: 3.0, chroma: 2.15, black: 1.0 },
    sheen: { knee: 11.0, gain: 0.46, tint: 0.38 },
    edge: 0.06,
    relief: { depth: 14.0 },
    reflect: { gain: 0.5, sharp: 22 },
}

light key = { from: (-1.2, 1.1, 0.6), color: #ffd9a0, gain: 1.30 }
light rim = { from: (0.9, -0.3, -1.5), color: #8fb8ff, gain: 0.90 }
light air = { ambient, color: #1e2740, gain: 0.22 }

-- ── THE WET LAYER ───────────────────────────────────────────────────────
-- Marks accumulate here and only here, which is what keeps the picture from
-- flashing: it is held in this buffer rather than rebuilt each frame out of
-- whichever stamps happen to be alive.
warp wet = {
    Prev
    | Lay { keep: 0.9950, gain: 1.0, cap: 20.0 }
    | Scroll(0, -0.00002)
    | Diffuse Sxyz { rate: 0.009 }
    | Diffuse Sw { rate: 0.009 }
}

warp canvas = {
    Scene
    | Paint(void)
    | Raking { from: Sw, light: key, depth: 26.0 }
    | Bloom { threshold: 0.76, strength: 0.16 }
}

-- ════════════════════════════════════════════════════════════════════════
-- THE SOLIDS.
--
-- Built from Lerp and Spawn, never Path. `Path` stamps its control points and
-- NOTHING between them (compile.rs: one Emit per point), so a four-point
-- square draws four dots; and `Smooth`, the op that would fill them in, is a
-- Catmull-Rom resample, which rounds exactly the corners that make these
-- shapes Held's. `Lerp { to: Direction(d), n }` interpolates LINEARLY from
-- every emit toward a per-emit offset, so it draws a straight edge, and
-- `Spawn { by: Rz(1/k) }` turns the accumulated set about the origin — an
-- edge placed off-centre and turned four times IS a square.
--
-- Draw `Sm` scales the emit set's offsets as well as its stamps (scale_mul
-- multiplies both), which is why `Overlay [ Sm 1, Sm 0.7 | Za(-0.12) ]` nests
-- a smaller copy further back instead of merely drawing thinner.
--
-- ── WHERE THE COST IS, because it dominates everything else here ─────────
--
-- A sounding note re-runs its whole draw EVERY 5 ms. FromSound(8, 6) is 48
-- events a second per stem and each lasts 1/6 s, so that is ~1600 draw-runs a
-- second per stem, times ten stems. At 300 emits a solid that is three and a
-- half MILLION emits a second: the brush spawn queue overflows, solids arrive
-- in pieces, and the render runs at a third of the impasto version's speed.
--
-- So the thinning has to happen BEFORE the expansion, not after it.
-- `Sometimes(p, <the whole construction>)` builds the solid on well under 1% of notes
-- and leaves the other 98% as a single emit, parked off-canvas by the
-- `Ya(-40)` above it. Average cost per note falls from 300 emits to about
-- seven. The earlier `Sometimes(p, Ya(-40))` at the END of the pipeline looked
-- equivalent and was worthless — it built all 300 emits and then moved them
-- offscreen, which is why every attempt at thinning left the render time and
-- the dropped-spawn counts exactly where they were.
--
-- Two consequences worth keeping in mind when tuning:
--   · `p` is now nearly free, so it is the right knob for density. Raise it
--     for a fuller canvas; the cost scales with p, not with the note rate.
--   · Because so few notes build, each one can afford a RICH solid — the
--     sampling below is dense enough that edges read as continuous rules
--     rather than bead chains.
--
-- And every voice sets `Sa`, a constant added to the stamp scale after the
-- gain multiply: without it line weight is proportional to loudness, and
-- FromSound's gains span two orders of magnitude inside one stem, so quiet
-- notes drew their edges out of specks. Held's line does not thin out when
-- the music does.
-- ════════════════════════════════════════════════════════════════════════

-- ── THE PATHS: A HOPF FIBRATION ────────────────────────────────────────
-- The ten parts used to ride a circle. They ride FIBRES now.
--
-- The Hopf map takes the 3-sphere to the 2-sphere, and the preimage of every
-- point of S² is a great circle in S³. Any two of those circles are LINKED —
-- they pass through one another exactly once and cannot be pulled apart
-- without cutting. So the ten stems are not ten paths near each other; they
-- are ten paths that are threaded through each other, and the picture cannot
-- be untangled into rows no matter where you stand.
--
-- This is not decoration borrowed from physics. S³ → S² is THE nontrivial
-- principal bundle, the one gauge theory is built out of: it is a qubit's
-- state space over the Bloch sphere, and it is the magnetic monopole. Each
-- stem is given a base point on S² — ten points spread by the golden angle so
-- no two fibres sit near each other — and its own fibre is the circle above
-- that point. Each also enters its fibre at a different PHASE (i·4π/10), or
-- all ten would sit at the same place on their circles at once and sweep
-- round together as a single clump: the fibres would be linked and you would
-- never see it.
--
-- Two consequences that are the geometry rather than choices:
--
--   THE SPINOR DOUBLE COVER. The half-angles below mean psi must run to 4π,
--   not 2π, before a fibre closes. A part goes round TWICE to come back to
--   where it started — the same fact that makes a spin-½ particle need two
--   full turns, and the reason SU(2) double-covers SO(3).
--
--   STEREOGRAPHIC PROJECTION. S³ does not fit in a frame, so it is projected
--   from the pole x0 = 1 into R³, which is what turns the fibres into the
--   nested rings of Villarceau circles. `theta` stays well short of π because
--   that pole is where the projection runs to infinity.

-- KICKS — an open cube, walking the bottom-left cell left to right.
draw cube = {
    let cube_psi = Note.t * 0.624 + 0.0000
    let cube_s   = sin(0.7200 / 2)
    let cube_c   = cos(0.7200 / 2)
    let cube_x0  = cos((cube_psi + 0.0000) / 2) * cube_s
    let cube_x1  = sin((cube_psi + 0.0000) / 2) * cube_s
    let cube_x2  = cos((cube_psi - 0.0000) / 2) * cube_c
    let cube_x3  = sin((cube_psi - 0.0000) / 2) * cube_c
    let cube_d   = 1.0 - cube_x0
    Point
    | Ya(-40)
    | Every(4,
        Ya(40)
        | Xa(-0.20) | Ya(-0.20)
        | Lerp { to: Direction(0.40, 0, 0), n: 21 }
        | Spawn { n: 4, by: Rz(1/4) }
        | Overlay [ Sm 1, Za(-0.34) ]
        | Ry(0.5 * 0.18 - 0.09)
        | Rx(0.5 * 0.14 - 0.07)
        | Ry(Note.t * 0.043)
        | Rz(Note.t * 0.017)
        | Overlay [ Sm 1, Sm 0.07,
                    Pick(0.5) | Lerp { to: Direction(1.25, 0.34, -0.90), n: 30 } ]
        | Sm(0.224 - Note.y * 0.146 + clamp(Note.z, 0.0, 0.3) * 0.326)
        | Tint(0.92 + Note.y * 0.20, 0.92 + Note.y * 0.10, 1.04 - Note.y * 0.16)
        | Tint((0.55 + 0.45 * (0.5 - cube_x3 / cube_d * 0.26)), (0.55 + 0.45 * (0.5 - cube_x3 / cube_d * 0.26)), (0.55 + 0.45 * (0.5 - cube_x3 / cube_d * 0.26)))
        | Xa(cube_x2 / cube_d * 0.90 + 0.02)
        | Ya(cube_x1 / cube_d * 0.178)
        | Za(cube_x3 / cube_d * 0.60)
        | Overlay [ Sm 1, Ry(0.26) | Rz(0.02) ]
        | Ry(sin(Note.t * 0.33) * 0.055)
        | Za(-2.10))
}

-- PERCUSSION 1 — a grid laid into perspective, climbing the far-left cell.
draw grid = {
    let grid_psi = Note.t * 0.624 + 6.2832
    let grid_s   = sin(1.1422 / 2)
    let grid_c   = cos(1.1422 / 2)
    let grid_x0  = cos((grid_psi + 5.7166) / 2) * grid_s
    let grid_x1  = sin((grid_psi + 5.7166) / 2) * grid_s
    let grid_x2  = cos((grid_psi - 5.7166) / 2) * grid_c
    let grid_x3  = sin((grid_psi - 5.7166) / 2) * grid_c
    let grid_d   = 1.0 - grid_x0
    Point
    | Ya(-40)
    | Every(4,
        Ya(40)
        | Xa(-0.26) | Ya(-0.13)
        | Lerp { to: Direction(0.52, 0, 0), n: 23 }
        | Spawn { n: 4, by: Ya(0.085) }
        | Overlay [ Sm 1, Rz(1/4) ]
        | Rx(1/4 + 0.5 * 0.12)
        | Ry(Note.t * 0.024)
        | Rz(Note.t * 0.010)
        | Overlay [ Sm 1, Sm 0.07 ]
        | Sm(0.31 - Note.y * 0.202 + clamp(Note.z, 0.0, 0.3) * 0.45)
        | Tint(0.92 + Note.y * 0.20, 0.92 + Note.y * 0.10, 1.04 - Note.y * 0.16)
        | Tint((0.55 + 0.45 * (0.5 - grid_x3 / grid_d * 0.26)), (0.55 + 0.45 * (0.5 - grid_x3 / grid_d * 0.26)), (0.55 + 0.45 * (0.5 - grid_x3 / grid_d * 0.26)))
        | Xa(grid_x2 / grid_d * 0.90 + 0.02)
        | Ya(grid_x1 / grid_d * 0.178)
        | Za(grid_x3 / grid_d * 0.60)
        | Overlay [ Sm 1, Ry(0.26) | Rz(0.02) ]
        | Ry(sin(Note.t * 0.33) * 0.055)
        | Za(-2.10))
}

-- PERCUSSION 2 — an open plane seen nearly sideways, on a closed circle.
draw plane = {
    let plane_psi = Note.t * 0.624 + 8.7965
    let plane_s   = sin(1.3111 / 2)
    let plane_c   = cos(1.3111 / 2)
    let plane_x0  = cos((plane_psi + 4.2334) / 2) * plane_s
    let plane_x1  = sin((plane_psi + 4.2334) / 2) * plane_s
    let plane_x2  = cos((plane_psi - 4.2334) / 2) * plane_c
    let plane_x3  = sin((plane_psi - 4.2334) / 2) * plane_c
    let plane_d   = 1.0 - plane_x0
    Point
    | Ya(-40)
    | Every(4,
        Ya(40)
        | Xa(-0.30) | Ya(-0.30)
        | Lerp { to: Direction(0.60, 0, 0), n: 21 }
        | Spawn { n: 4, by: Rz(1/4) }
        | Overlay [ Sm 1, Sm 0.55 ]
        | Rx(2/5 + 0.5 * 0.2)
        | Ry(Rand(20) * 0.4 - 0.2)
        | Ry(Note.t * 0.038)
        | Rz(Note.t * 0.015)
        | Overlay [ Sm 1, Sm 0.07 ]
        | Sm(0.31 - Note.y * 0.202 + clamp(Note.z, 0.0, 0.3) * 0.45)
        | Tint(0.92 + Note.y * 0.20, 0.92 + Note.y * 0.10, 1.04 - Note.y * 0.16)
        | Tint((0.55 + 0.45 * (0.5 - plane_x3 / plane_d * 0.26)), (0.55 + 0.45 * (0.5 - plane_x3 / plane_d * 0.26)), (0.55 + 0.45 * (0.5 - plane_x3 / plane_d * 0.26)))
        | Xa(plane_x2 / plane_d * 0.90 + 0.02)
        | Ya(plane_x1 / plane_d * 0.178)
        | Za(plane_x3 / plane_d * 0.60)
        | Overlay [ Sm 1, Ry(0.26) | Rz(0.02) ]
        | Ry(sin(Note.t * 0.33) * 0.055)
        | Za(-2.10))
}

-- BASS SYNTH — a tunnel of frames on a diagonal that also walks away
-- from the camera. The Held motif you look INTO, going.
draw tunnel = {
    let tunnel_psi = Note.t * 0.624 + 1.2566
    let tunnel_s   = sin(0.8044 / 2)
    let tunnel_c   = cos(0.8044 / 2)
    let tunnel_x0  = cos((tunnel_psi + 2.4000) / 2) * tunnel_s
    let tunnel_x1  = sin((tunnel_psi + 2.4000) / 2) * tunnel_s
    let tunnel_x2  = cos((tunnel_psi - 2.4000) / 2) * tunnel_c
    let tunnel_x3  = sin((tunnel_psi - 2.4000) / 2) * tunnel_c
    let tunnel_d   = 1.0 - tunnel_x0
    Point
    | Ya(-40)
    | Every(14,
        Ya(40)
        | Xa(-0.24) | Ya(-0.24)
        | Lerp { to: Direction(0.48, 0, 0), n: 18 }
        | Spawn { n: 4, by: Rz(1/4) }
        | Overlay [ Sm 1, Sm 0.64 | Za(-0.22), Sm 0.38 | Za(-0.44) ]
        | Ry(0.5 * 0.16 - 0.08)
        | Ry(Note.t * 0.031)
        | Rz(Note.t * 0.012)
        | Overlay [ Sm 1, Sm 0.07,
                    Pick(0.5) | Lerp { to: Direction(1.15, -0.40, -1.00), n: 30 } ]
        | Sm(0.224 - Note.y * 0.146 + clamp(Note.z, 0.0, 0.3) * 0.326)
        | Tint(0.92 + Note.y * 0.20, 0.92 + Note.y * 0.10, 1.04 - Note.y * 0.16)
        | Tint((0.55 + 0.45 * (0.5 - tunnel_x3 / tunnel_d * 0.26)), (0.55 + 0.45 * (0.5 - tunnel_x3 / tunnel_d * 0.26)), (0.55 + 0.45 * (0.5 - tunnel_x3 / tunnel_d * 0.26)))
        | Xa(tunnel_x2 / tunnel_d * 0.90 + 0.02)
        | Ya(tunnel_x1 / tunnel_d * 0.178)
        | Za(tunnel_x3 / tunnel_d * 0.60)
        | Overlay [ Sm 1, Ry(0.26) | Rz(0.02) ]
        | Ry(sin(Note.t * 0.33) * 0.055)
        | Za(-2.10))
}

-- PADS — a tilted torus on a shallow arc over the top-centre cell.
draw torus = {
    let torus_psi = Note.t * 0.624 + 3.7699
    let torus_s   = sin(0.9733 / 2)
    let torus_c   = cos(0.9733 / 2)
    let torus_x0  = cos((torus_psi + 0.9167) / 2) * torus_s
    let torus_x1  = sin((torus_psi + 0.9167) / 2) * torus_s
    let torus_x2  = cos((torus_psi - 0.9167) / 2) * torus_c
    let torus_x3  = sin((torus_psi - 0.9167) / 2) * torus_c
    let torus_d   = 1.0 - torus_x0
    Point
    | Ya(-40)
    | Every(16,
        Ya(40)
        | Xa(0.3)
        | Spawn { n: 43, by: Rz(1/43) }
        | Overlay [ Sm 1, Sm 0.72 ]
        | Rx(1/5 + 0.5 * 0.1)
        | Ry(Note.t * 0.019)
        | Rz(Note.t * 0.008)
        | Overlay [ Sm 1, Sm 0.07,
                    Pick(0.5) | Lerp { to: Direction(-1.05, -0.46, -0.72), n: 30 } ]
        | Sm(0.31 - Note.y * 0.202 + clamp(Note.z, 0.0, 0.3) * 0.45)
        | Tint(0.92 + Note.y * 0.20, 0.92 + Note.y * 0.10, 1.04 - Note.y * 0.16)
        | Tint((0.55 + 0.45 * (0.5 - torus_x3 / torus_d * 0.26)), (0.55 + 0.45 * (0.5 - torus_x3 / torus_d * 0.26)), (0.55 + 0.45 * (0.5 - torus_x3 / torus_d * 0.26)))
        | Xa(torus_x2 / torus_d * 0.90 + 0.02)
        | Ya(torus_x1 / torus_d * 0.178)
        | Za(torus_x3 / torus_d * 0.60)
        | Overlay [ Sm 1, Ry(0.26) | Rz(0.02) ]
        | Ry(sin(Note.t * 0.33) * 0.055)
        | Za(-2.10))
}

-- BASS ARPS — a helix climbing the centre cell, turning in x and z as it
-- goes: the one wire that is itself a solid's worth of geometry.
draw coil = {
    let coil_psi = Note.t * 0.624 + 2.5133
    let coil_s   = sin(0.8889 / 2)
    let coil_c   = cos(0.8889 / 2)
    let coil_x0  = cos((coil_psi + 4.7999) / 2) * coil_s
    let coil_x1  = sin((coil_psi + 4.7999) / 2) * coil_s
    let coil_x2  = cos((coil_psi - 4.7999) / 2) * coil_c
    let coil_x3  = sin((coil_psi - 4.7999) / 2) * coil_c
    let coil_d   = 1.0 - coil_x0
    Point
    | Ya(-40)
    | Every(7,
        Ya(40)
        | Xa(0.15)
        | Spawn { n: 43, by: Rz(1/22) | Ya(0.0054) | Za(-0.0042) }
        | Ry(Note.t * 0.057)
        | Rz(Note.t * 0.023)
        | Overlay [ Sm 1, Sm 0.07,
                    Pick(0.5) | Lerp { to: Direction(1.05, 0.55, -0.95), n: 30 } ]
        | Sm(0.31 - Note.y * 0.202 + clamp(Note.z, 0.0, 0.3) * 0.45)
        | Tint(0.92 + Note.y * 0.20, 0.92 + Note.y * 0.10, 1.04 - Note.y * 0.16)
        | Tint((0.55 + 0.45 * (0.5 - coil_x3 / coil_d * 0.26)), (0.55 + 0.45 * (0.5 - coil_x3 / coil_d * 0.26)), (0.55 + 0.45 * (0.5 - coil_x3 / coil_d * 0.26)))
        | Xa(coil_x2 / coil_d * 0.90 + 0.02)
        | Ya(coil_x1 / coil_d * 0.178)
        | Za(coil_x3 / coil_d * 0.60)
        | Overlay [ Sm 1, Ry(0.26) | Rz(0.02) ]
        | Ry(sin(Note.t * 0.33) * 0.055)
        | Za(-2.10))
}

-- ARP SYNTHS — a transparent cylinder on a rising diagonal.
draw cylinder = {
    let cylinder_psi = Note.t * 0.624 + 10.0531
    let cylinder_s   = sin(1.3956 / 2)
    let cylinder_c   = cos(1.3956 / 2)
    let cylinder_x0  = cos((cylinder_psi + 0.3501) / 2) * cylinder_s
    let cylinder_x1  = sin((cylinder_psi + 0.3501) / 2) * cylinder_s
    let cylinder_x2  = cos((cylinder_psi - 0.3501) / 2) * cylinder_c
    let cylinder_x3  = sin((cylinder_psi - 0.3501) / 2) * cylinder_c
    let cylinder_d   = 1.0 - cylinder_x0
    Point
    | Ya(-40)
    | Every(5,
        Ya(40)
        | Xa(0.17)
        | Lerp { to: Direction(0, 0, -0.46), n: 15 }
        | Spawn { n: 5, by: Rz(1/5) }
        | Rx(0.5 * 0.16 - 0.08)
        | Ry(Note.t * 0.034)
        | Rz(Note.t * 0.014)
        | Overlay [ Sm 1, Sm 0.07,
                    Pick(0.5) | Lerp { to: Direction(-1.20, 0.42, -0.75), n: 30 } ]
        | Sm(0.31 - Note.y * 0.202 + clamp(Note.z, 0.0, 0.3) * 0.45)
        | Tint(0.92 + Note.y * 0.20, 0.92 + Note.y * 0.10, 1.04 - Note.y * 0.16)
        | Tint((0.55 + 0.45 * (0.5 - cylinder_x3 / cylinder_d * 0.26)), (0.55 + 0.45 * (0.5 - cylinder_x3 / cylinder_d * 0.26)), (0.55 + 0.45 * (0.5 - cylinder_x3 / cylinder_d * 0.26)))
        | Xa(cylinder_x2 / cylinder_d * 0.90 + 0.02)
        | Ya(cylinder_x1 / cylinder_d * 0.178)
        | Za(cylinder_x3 / cylinder_d * 0.60)
        | Overlay [ Sm 1, Ry(0.26) | Rz(0.02) ]
        | Ry(sin(Note.t * 0.33) * 0.055)
        | Za(-2.10))
}

-- CLARINET — a cone on an S curve. Built from the APEX outward, because
-- Lerp's anchor is per-emit relative: spokes cannot converge on a point, but
-- they can all start at one, and the rim is a chord laid at the spoke's far
-- end and turned with it.
draw cone = {
    let cone_psi = Note.t * 0.624 + 5.0265
    let cone_s   = sin(1.0578 / 2)
    let cone_c   = cos(1.0578 / 2)
    let cone_x0  = cos((cone_psi + 3.3167) / 2) * cone_s
    let cone_x1  = sin((cone_psi + 3.3167) / 2) * cone_s
    let cone_x2  = cos((cone_psi - 3.3167) / 2) * cone_c
    let cone_x3  = sin((cone_psi - 3.3167) / 2) * cone_c
    let cone_d   = 1.0 - cone_x0
    Point
    | Ya(-40)
    | Every(8,
        Ya(40)
        | Overlay [
            Lerp { to: Direction(0.24, 0, -0.40), n: 15 },
            Xa(0.24) | Za(-0.40) | Lerp { to: Direction(-0.0183, 0.0918, 0), n: 4 }
          ]
        | Spawn { n: 7, by: Rz(1/7) }
        | Rx(0.5 * 0.12 - 0.20)
        | Ry(Note.t * 0.049)
        | Rz(Note.t * 0.020)
        | Overlay [ Sm 1, Sm 0.07,
                    Pick(0.5) | Lerp { to: Direction(0.92, -0.52, -1.15), n: 30 } ]
        | Sm(0.31 - Note.y * 0.202 + clamp(Note.z, 0.0, 0.3) * 0.45)
        | Tint(0.92 + Note.y * 0.20, 0.92 + Note.y * 0.10, 1.04 - Note.y * 0.16)
        | Tint((0.55 + 0.45 * (0.5 - cone_x3 / cone_d * 0.26)), (0.55 + 0.45 * (0.5 - cone_x3 / cone_d * 0.26)), (0.55 + 0.45 * (0.5 - cone_x3 / cone_d * 0.26)))
        | Xa(cone_x2 / cone_d * 0.90 + 0.02)
        | Ya(cone_x1 / cone_d * 0.178)
        | Za(cone_x3 / cone_d * 0.60)
        | Overlay [ Sm 1, Ry(0.26) | Rz(0.02) ]
        | Ry(sin(Note.t * 0.33) * 0.055)
        | Za(-2.10))
}

-- MELODY SYNTH — a hard slab climbing the far-right cell.
draw slab = {
    let slab_psi = Note.t * 0.624 + 11.3097
    let slab_s   = sin(1.4800 / 2)
    let slab_c   = cos(1.4800 / 2)
    let slab_x0  = cos((slab_psi + 2.7501) / 2) * slab_s
    let slab_x1  = sin((slab_psi + 2.7501) / 2) * slab_s
    let slab_x2  = cos((slab_psi - 2.7501) / 2) * slab_c
    let slab_x3  = sin((slab_psi - 2.7501) / 2) * slab_c
    let slab_d   = 1.0 - slab_x0
    Point
    | Ya(-40)
    | Every(8,
        Ya(40)
        | Xa(-0.19)
        | Lerp { to: Direction(0.38, 0, 0), n: 27 }
        | Overlay [ Sm 1, Ya(0.02), Ya(-0.02), Ya(0.04), Ya(-0.04) ]
        | Rz(0.5 * 0.12 - 0.06)
        | Ry(Note.t * 0.027)
        | Rz(Note.t * 0.011)
        | Overlay [ Sm 1, Sm 0.07,
                    Pick(0.5) | Lerp { to: Direction(-1.35, 0.30, -0.85), n: 30 } ]
        | Sm(0.31 - Note.y * 0.202 + clamp(Note.z, 0.0, 0.3) * 0.45)
        | Tint(0.92 + Note.y * 0.20, 0.92 + Note.y * 0.10, 1.04 - Note.y * 0.16)
        | Tint((0.55 + 0.45 * (0.5 - slab_x3 / slab_d * 0.26)), (0.55 + 0.45 * (0.5 - slab_x3 / slab_d * 0.26)), (0.55 + 0.45 * (0.5 - slab_x3 / slab_d * 0.26)))
        | Xa(slab_x2 / slab_d * 0.90 + 0.02)
        | Ya(slab_x1 / slab_d * 0.178)
        | Za(slab_x3 / slab_d * 0.60)
        | Overlay [ Sm 1, Ry(0.26) | Rz(0.02) ]
        | Ry(sin(Note.t * 0.33) * 0.055)
        | Za(-2.10))
}

-- SAX — a twisting ribbon on the circle that closes the field.
draw ribbon = {
    -- Where in the phrase this note falls, 0 at the downbeat, 1 at the end.
    -- Two bars at 143 BPM, offset to the sax's own entries (0.90, 4.25,
    -- 7.60, 10.95s measured), because the window opens mid-phrase.
    let sax_ph = Wrap(Note.t - 0.90, 3.3566) / 3.3566
    Point
    | Ya(-40)
    | Every(8,
        Ya(40)
        | Lerp { to: Direction(0, 0.30, 0), n: 16 }
        | Spawn { n: 18, by: Xa(0.0400) | Rz(1/80) | Za(-0.0180) }
        | Xa(-0.13)
        | Rz(Note.t * 0.021)
        | Overlay [ Sm 1, Sm 0.07 ]
        | Sm(0.60 - Note.y * 0.34 + clamp(Note.z, 0.0, 0.3) * 0.92)
        | Tint(0.92 + Note.y * 0.20, 0.92 + Note.y * 0.10, 1.04 - Note.y * 0.16)
        | Overlay [
            Xa(-1.90) | Ya(-0.40 + 0.80 * sax_ph),
            Xa(1.90)  | Ya(0.40 - 0.80 * sax_ph)
          ]
        | Za(-2.10))
}

-- ════════════════════════════════════════════════════════════════════════
-- THE VOICES.
--
-- `Gm` is loudness; wgsl `Sm` is LINE WEIGHT — the draw geometry already
-- fixes each solid's size, so this only decides how heavy the edge is drawn.
-- No Slew, no Bm ramp, no drift: a shape appears whole, holds, and dies
-- whole. `Vm 0` everywhere, because Held's solids do not move.
--
-- FitX is degenerate and has to be: the analysis is mono and the CSV shows
-- pan identically 0 for all 97,570 notes, so x can only ever come from the
-- layout. FitY is not degenerate — it is where PITCH lives. Each voice's own
-- frequency range is mapped onto its cell's height, so a solid rides up and
-- down inside its cell as the part plays, and the band is sized per depth
-- layer because placement happens before projection.
--
-- Colour: three families, used twice each so the frame holds together —
-- coral/salmon/peach, turquoise/aqua/mint, cream/butter/gold — plus one
-- magenta and one cobalt to carry the low end. No black anywhere: on a
-- twilight ground the darkest thing in the picture should still be blue.
-- ════════════════════════════════════════════════════════════════════════

-- ─── far field: routed to `space`, the chain with the feedback ───────────

pads = {
    FromSound(8, 6) ./jimbocho/pads.wav
    | Gm 2
    | Color [brightpurple, violet, darkpurple]
    | Gradient(0, 1, 0)
    | wgsl { Sm "3.7 * (1.0 - exp(-Time * 3.2)) * (1.0 + 0.55 * exp(-Time * 9.0))"; Sa 0; Vm 0.55; Bm "(1.0 - exp(-Time * 3.2)) * (0.82 + 0.18 * exp(-Time * 1.2))"; Die 5/2; red = red + exp(0.0 - time * 4.5) * 0.92; green = green + exp(0.0 - time * 4.5) * 0.59; blue = blue + exp(0.0 - time * 4.5) * 0.35; Seq [ Direction(0.02, 0.01, -0.30) | Lm 4; ]; }
    | torus
    | FitX 0 0
    | FitY -0.395 0.395
    | FitZ 0 0
    | #pads
}

perc1 = {
    FromSound(8, 6) ./jimbocho/perc1.wav
    | Gm 2
    | Color [white, silver, lightgrey]
    | Gradient(0, 1, 0)
    | wgsl { Sm "9.66 * (1.0 - exp(-Time * 70.0)) * (0.25 + 0.95 * exp(-Time * 15.0))"; Sa 0; Vm 0.36; Bm "(1.0 - exp(-Time * 70.0)) * (0.14 + 0.86 * exp(-Time * 17.0))"; Die 1/5; red = red + exp(0.0 - time * 19.4) * 1.94; green = green + exp(0.0 - time * 19.4) * 1.28; blue = blue + exp(0.0 - time * 19.4) * 0.73; Seq [ Direction(-0.03, 0.05, -0.19) | Lm 4; ]; }
    | grid
    | FitX 0 0
    | FitY -0.395 0.395
    | FitZ 0 0
    | #perc1
}

bass_arps = {
    FromSound(8, 6) ./jimbocho/bass_arps.wav
    | Gm 2
    | Color [brightgreen, kellygreen, forestgreen]
    | Gradient(0, 1, 0)
    | wgsl { Sm "7.46 * (1.0 - exp(-Time * 18.0)) * (0.50 + 0.85 * exp(-Time * 4.0))"; Sa 0; Vm 0.44; Bm "(1.0 - exp(-Time * 18.0)) * (0.38 + 0.62 * exp(-Time * 5.0))"; Die 1; red = red + exp(0.0 - time * 13.1) * 1.61; green = green + exp(0.0 - time * 13.1) * 1.05; blue = blue + exp(0.0 - time * 13.1) * 0.62; Seq [ Direction(0.05, -0.05, -0.21) | Lm 4; ]; }
    | coil
    | FitX 0 0
    | FitY -0.395 0.395
    | FitZ 0 0
    | #bass_arps
}

-- ─── middle ground: occludes the far field ───────────────────────────────

bass_synth = {
    FromSound(8, 6) ./jimbocho/bass_synth.wav
    | Gm 2
    | Color [royalblue, ultramarine, darkblue]
    | Gradient(0, 1, 0)
    | wgsl { Sm "4.29 * (1.0 - exp(-Time * 3.2)) * (1.0 + 0.55 * exp(-Time * 9.0))"; Sa 0; Vm 0.50; Bm "(1.0 - exp(-Time * 3.2)) * (0.82 + 0.18 * exp(-Time * 1.2))"; Die 5/2; red = red + exp(0.0 - time * 4.8) * 1.04; green = green + exp(0.0 - time * 4.8) * 0.69; blue = blue + exp(0.0 - time * 4.8) * 0.39; Seq [ Direction(0.04, -0.03, -0.25) | Lm 4; ]; }
    | tunnel
    | FitX 0 0
    | FitY -0.395 0.395
    | FitZ 0 0
    | #bass_synth
}

arps = {
    FromSound(8, 6) ./jimbocho/arps.wav
    | Gm 2
    | Color [brightyellow, yellow, gold]
    | Gradient(0, 1, 0)
    | wgsl { Sm "10.3 * (1.0 - exp(-Time * 70.0)) * (0.25 + 0.95 * exp(-Time * 15.0))"; Sa 0; Vm 0.48; Bm "(1.0 - exp(-Time * 70.0)) * (0.14 + 0.86 * exp(-Time * 17.0))"; Die 1/5; red = red + exp(0.0 - time * 17.6) * 1.84; green = green + exp(0.0 - time * 17.6) * 1.22; blue = blue + exp(0.0 - time * 17.6) * 0.69; Seq [ Direction(0.06, 0.03, -0.24) | Lm 4; ]; }
    | cylinder
    | FitX 0 0
    | FitY -0.395 0.395
    | FitZ 0 0
    | #arps
}

clarinet = {
    FromSound(8, 6) ./jimbocho/clarinet.wav
    | Gm 2
    | Color [tangerine, orange, pumpkin]
    | Gradient(0, 1, 0)
    | wgsl { Sm "7.77 * (1.0 - exp(-Time * 18.0)) * (0.50 + 0.85 * exp(-Time * 4.0))"; Sa 0; Vm 0.42; Bm "(1.0 - exp(-Time * 18.0)) * (0.38 + 0.62 * exp(-Time * 5.0))"; Die 1; red = red + exp(0.0 - time * 11.5) * 1.61; green = green + exp(0.0 - time * 11.5) * 1.05; blue = blue + exp(0.0 - time * 11.5) * 0.62; Seq [ Direction(-0.05, 0.02, -0.20) | Lm 4; ]; }
    | cone
    | FitX 0 0
    | FitY -0.395 0.395
    | FitZ 0 0
    | #clarinet
}

perc2 = {
    FromSound(8, 6) ./jimbocho/perc2.wav
    | Gm 2
    | Color [cyan, turquoise, darkturquoise]
    | Gradient(0, 1, 0)
    | wgsl { Sm "14.1 * (1.0 - exp(-Time * 70.0)) * (0.25 + 0.95 * exp(-Time * 15.0))"; Sa 0; Vm 0.38; Bm "(1.0 - exp(-Time * 70.0)) * (0.14 + 0.86 * exp(-Time * 17.0))"; Die 1/5; red = red + exp(0.0 - time * 19.4) * 1.94; green = green + exp(0.0 - time * 19.4) * 1.28; blue = blue + exp(0.0 - time * 19.4) * 0.73; Seq [ Direction(-0.04, -0.04, -0.16) | Lm 4; ]; }
    | plane
    | FitX 0 0
    | FitY -0.395 0.395
    | FitZ 0 0
    | #perc2
}

-- ─── front: occludes everything ──────────────────────────────────────────

kicks = {
    FromSound(8, 6) ./jimbocho/kicks.wav
    | Gm 2
    | Color [scarlet, vermillion, darkred]
    | Gradient(0, 1, 0)
    | wgsl { Sm "13.3 * (1.0 - exp(-Time * 70.0)) * (0.25 + 0.95 * exp(-Time * 15.0))"; Sa 0; Vm 0.45; Bm "(1.0 - exp(-Time * 70.0)) * (0.14 + 0.86 * exp(-Time * 17.0))"; Die 1/5; red = red + exp(0.0 - time * 19.4) * 2.17; green = green + exp(0.0 - time * 19.4) * 1.44; blue = blue + exp(0.0 - time * 19.4) * 0.82; Seq [ Direction(0.05, -0.02, -0.22) | Lm 4; ]; }
    | cube
    | FitX 0 0
    | FitY -0.395 0.395
    | FitZ 0 0
    | #kicks
}

sax = {
    FromSound(8, 6) ./jimbocho/sax.wav
    | Gm 2
    | Color [neonpink, magenta, darkmagenta]
    | Gradient(0, 1, 0)
    | wgsl { Sm "7.41 * (1.0 - exp(-Time * 18.0)) * (0.50 + 0.85 * exp(-Time * 4.0))"; Sa 0; Vm 0.40; Bm "(1.0 - exp(-Time * 18.0)) * (0.38 + 0.62 * exp(-Time * 5.0))"; Die 1; red = red + exp(0.0 - time * 11.5) * 1.71; green = green + exp(0.0 - time * 11.5) * 1.12; blue = blue + exp(0.0 - time * 11.5) * 0.66; Seq [ Direction(-0.06, 0.03, -0.18) | Lm 4; ]; }
    | ribbon
    | FitX 0 0
    | FitY -0.11 0.11
    | FitZ 0 0
    | #sax
}

melody = {
    FromSound(8, 6) ./jimbocho/melody.wav
    | Gm 2
    | Color [chartreuse, lime, olivegreen]
    | Gradient(0, 1, 0)
    | wgsl { Sm "8.22 * (1.0 - exp(-Time * 18.0)) * (0.50 + 0.85 * exp(-Time * 4.0))"; Sa 0; Vm 0.35; Bm "(1.0 - exp(-Time * 18.0)) * (0.38 + 0.62 * exp(-Time * 5.0))"; Die 1; red = red + exp(0.0 - time * 11.5) * 1.71; green = green + exp(0.0 - time * 11.5) * 1.12; blue = blue + exp(0.0 - time * 11.5) * 0.66; Seq [ Direction(0.03, 0.04, -0.15) | Lm 4; ]; }
    | slab
    | FitX 0 0
    | FitY -0.395 0.395
    | FitZ 0 0
    | #melody
}

main = {
    Overlay [
        pads, perc1, bass_arps,
        bass_synth, arps, clarinet, perc2,
        kicks, sax, melody,
    ]
    | wet
    | canvas
} -> [kicks, perc1, perc2, bass_synth, bass_arps, pads, arps, clarinet, melody, sax]
