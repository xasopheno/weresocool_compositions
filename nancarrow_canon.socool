{ f: 80, l: 1/8, g: 1, p: 0 }

-- Tempo canon for drum machines, after Conlon Nancarrow.
-- One 20-pulse phrase, three voices, three speeds:
--   voice 1: Lm 1    (x3 per block)  — kick / snare / rimshot
--   voice 2: Lm 3/4  (x4 per block)  — toms / maraca
--   voice 3: Lm 1/2  (x6 per block)  — hats / glass
-- The voices state the same rhythm at 4:3:2. They only line up every
-- 60 pulses; between meetings the same phrase rains down at three
-- rates. Coda: all three kits play the phrase in unison — arrival.
--
-- Play: weresocool play nancarrow_canon.socool

x = { Silence 1 }

-- the phrase: strokes on 0, 3, 6, 8, 10, 13, 14, 17 of 20
p(lo, hi, tk) = {
    Seq [
        lo, x, x, tk | Gm 0.7,   x, x, hi, x,
        tk, x, lo | Gm 0.8, x,   x, hi, tk | Gm 0.7, x,
        x, hi | Gm 0.8, x, x
    ]
}

v1 = { p(Kick 808 | Gm 1, Snare 808 | Gm 0.75, Rimshot 808 | Gm 0.5) }
v2 = { p(Tom acoustic | Gm 0.8 | Pa -1/3, Tom acoustic | Fm 3/2 | Gm 0.7 | Pa -1/3, Shaker maraca | Gm 0.5 | Pa -1/3) }
v3 = { p(HiHat 909 | Gm 0.45 | Pa 1/3, Tom glass | Fm 2 | Gm 0.4 | Pa 1/3, Shaker 808 | Gm 0.35 | Pa 1/3) }

-- one convergence block: 60 pulses, voices meet only at the seams
block = {
    Overlay [
        v1 | Repeat 3,
        v2 | Lm 3/4 | Repeat 4,
        v3 | Lm 1/2 | Repeat 6
    ]
}

-- unison: all three kits, same speed — the canon resolves
unison = {
    Overlay [v1, v2, v3]
}

main = {
    Seq [
        v1 | Repeat 3,
        Overlay [v1 | Repeat 3, v2 | Lm 3/4 | Repeat 4],
        block,
        block,
        block | Fm 6/5,
        unison,
        unison | Fm 6/5,
        Overlay [
            Kick 808 | Gm 1 | Lm 4,
            Tom acoustic | Gm 0.8 | Lm 4,
            Crash acoustic | Gm 0.5 | Lm 4
        ]
    ]
}
