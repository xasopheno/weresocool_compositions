{ f: 65, l: 1/10, g: 1, p: 0, background_color: #000000, h: 1 }

-- THE GAME, PAINTED.
--
-- This piece rolls dice: Choose re-rolls every Repeat, so no two
-- performances are the same music. The picture takes that seriously —
-- the canvas is a TABLE, and every throw leaves a mark it cannot take
-- back. Placement is still a lattice walked by note index (the table
-- does not move); what the dice decide is WHICH marks land, how hard,
-- and how distorted. By the last bar the table is buried in the record
-- of its own game.
--
--   kick  → PIPS: filled discs, the die faces, set down in charcoal
--   blip  → ARCS: the glass melody sweeping through depth, cobalt
--   snare → COILS: spirals that unroll where the throw lands, cadmium
--   hats  → FLECKS: gold-green chaff thrown off the rolling dice
--   clap  → SLASHES: the tally strokes, violet, cutting across
--
-- Two lights, because the table has depth: a warm key from the near
-- corner, a cold rim from behind the far edge, and a deep blue ambient
-- standing in for the room.
light key = { from: (-1.5, 0.95, 0.55), color: #ffe9c4, gain: 1.0 }
light rim = { from: (1.1, -0.35, -1.4), color: #7fb0ff, gain: 0.60 }
light air = { ambient, color: #2b3450, gain: 0.55 }

-- ── THE WET LAYER ───────────────────────────────────────────────────
-- Marks accumulate here and only here. `Lay` keeps the paint in the
-- state buffer verbatim; `cap` is the only limiter, so piled-up
-- passages keep their hue instead of drifting as they saturate.
warp wet = {
    Prev
    | Lay { keep: 0.9880, gain: 1.0, cap: 6.0 }
    | Diffuse Sxyz { rate: 0.115 }
    | Diffuse Sw { rate: 0.115 }
}

-- ── THE TABLE ───────────────────────────────────────────────────────
-- Cotton rag. Paint is subtractive on it: a hex's value is how much
-- pigment sits there, not how bright the mark glows.
warp canvas = {
    Scene
    | Paint(rag)
}

-- ── THE SHAPES ──────────────────────────────────────────────────────
-- Every figure is the same three steps: Spawn a trail, drive x and y
-- from Stroke, run the weight down. Lattices are walked by Count —
-- the dice pick the events, never the places.

-- kick: a filled disc — a pip pressed into the felt
draw pip = {
    let k = Wrap(Count, 9.0)
    let m = Wrap(floor(Count / 9.0), 5.0)
    let dir = 0.0 - 1.0 + 2.0 * floor(m / 3.0)
    let depth = 0.0 - 0.15 - m * 0.42
    let cx = 0.0 - 1.28 + k * 0.32
    let cy = 0.0 - 0.34 + m * 0.30
    let r = 0.055 + Note.z * 0.075

    Point
    | Spawn { n: 9, by: Sm(0.86) }
    | Spawn { n: 46, by: Sm(1.0) }
        | Xa(sin(Stroke * 6.28318) * r * dir)
        | Ya(cos(Stroke * 6.28318) * r * 2.0)
    | Jitter(0.0009)
    | Gradient
    | Warm(0.42 - 0.10 * m)
    | Xf(cx)
    | Overlay [
        Yf(cy * 0.17),
        Mirror(X) | Yf(0.30 + cy * 0.17),
        Mirror(X) | Yf(0.0 - 0.30 - cy * 0.17),
      ]
    | Tint(1.0, 0.98, 0.94, 0.42)
}

-- blip: an arc swung through depth — the glass note is the one voice
-- that moves TOWARD you, so it rides the rim light
draw orbital = {
    let k = Wrap(Count, 7.0)
    let m = Wrap(floor(Count / 7.0), 4.0)
    let dir = 0.0 - 1.0 + 2.0 * floor(m / 2.0)
    let depth = 0.0 - 0.20 - m * 0.50
    let ax = 0.0 - 1.10 + k * 0.36
    let ay = 0.0 - 0.26 + m * 0.34
    let sweep = 0.55 + Note.z * 0.55

    Point
    | Spawn { n: 190, by: Sm(0.9990) }
        | Xa(sin(Stroke * 1.9 + 0.3) * sweep * dir)
        | Ya(cos(Stroke * 1.9 + 0.3) * sweep * 1.6 * dir)
        | Za(depth + sin(Stroke * 3.14159) * 0.10)
    | Spawn { n: 3, by: Ya(0.004) }
    | Jitter(0.0008)
    | Gradient(rim)
    | Cool(0.20 + 0.09 * m)
    | Xf(ax)
    | Overlay [
        Yf(ay * 0.17),
        Mirror(X) | Yf(0.30 + ay * 0.17),
        Mirror(X) | Yf(0.0 - 0.30 - ay * 0.17),
      ]
    | Tint(0.94, 0.97, 1.0, 0.30)
}

-- snare: a spiral that unrolls at the moment of the throw — Stagger
-- lays the coil in order, so the hit draws itself outward
draw coil = {
    let k = Wrap(Count, 11.0)
    let m = Wrap(floor(Count / 11.0), 4.0)
    let dir = 0.0 - 1.0 + 2.0 * floor(m / 2.0)
    let depth = 0.0 - 0.10 - m * 0.46
    let sx = 0.0 - 1.30 + k * 0.26
    let sy = 0.0 - 1.30 + m * 0.18
    let turns = 2.6 + Note.z * 1.6
    let reach = (0.12 + Note.z * 0.16) * (1.5 - 0.22 * m)

    Point
    | Spawn { n: 620, by: Sm(0.9990) }
        | Xa(cos(Stroke * 6.28318 * turns) * reach * Stroke * dir)
        | Ya(sin(Stroke * 6.28318 * turns) * reach * Stroke * 2.0)
        | Za(depth + Stroke * 0.22)
    | Jitter(0.0007)
    | Stagger { over: 0.60 }
    | Gradient
    | Xf(sx)
    | Overlay [
        Yf(sy * 0.20 - 0.92),
        Mirror(X) | Yf(0.0 - 0.52 + sy * 0.20),
        Mirror(X) | Yf(0.0 - 1.18 - sy * 0.20),
      ]
    | Tint(1.0, 0.97, 0.96, 0.45)
}

-- hats: flecks thrown off the roll, scattered through the volume
draw fleck = {
    let k = Wrap(Count, 23.0)
    let m = Wrap(floor(Count / 23.0), 7.0)
    let dir = 0.0 - 1.0 + 2.0 * floor(m / 4.0)
    let depth = 0.0 - 0.05 - m * 0.30
    let px = 0.0 - 1.34 + k * 0.122
    let py = 0.0 - 0.36 + m * 0.115
    let r = 0.012 + Note.z * 0.010

    Point
    | Spawn { n: 5, by: Sm(0.84) | Xa(0.006 * dir) }
    | Spawn { n: 22, by: Sm(1.0) }
        | Xa(sin(Stroke * 6.28318) * r * dir)
        | Ya(cos(Stroke * 6.28318) * r * 2.0)
    | Jitter(0.0005)
    | Gradient
    | Warm(0.50 - 0.06 * m)
    | Xf(px)
    | Overlay [
        Yf(py * 0.17),
        Mirror(X) | Yf(0.30 + py * 0.17),
        Mirror(X) | Yf(0.0 - 0.30 - py * 0.17),
      ]
    | Tint(1.0, 0.94, 0.92, 0.40)
}

-- clap: a tally stroke — one straight cut across the felt
draw slash = {
    let k = Wrap(Count, 5.0)
    let m = Wrap(floor(Count / 5.0), 4.0)
    let dir = 0.0 - 1.0 + 2.0 * (k - 2.0 * floor(k / 2.0))
    let depth = 0.0 - 0.12 - m * 0.40
    let px = 0.0 - 1.15 + k * 0.55
    let py = 0.0 - 0.30 + m * 0.22
    let len = 0.45 + Note.z * 0.40

    Point
    | Spawn { n: 240, by: Sm(0.9992) }
        | Xa((Stroke - 0.5) * len * 2.0 * dir)
        | Ya((Stroke - 0.5) * len * 0.7)
        | Za(depth)
    | Jitter(0.0008)
    | Gradient
    | Cool(0.16 + 0.07 * m)
    | Xf(px)
    | Overlay [
        Yf(py * 0.17),
        Mirror(X) | Yf(0.30 + py * 0.17),
        Mirror(X) | Yf(0.0 - 0.30 - py * 0.17),
      ]
    | Tint(0.96, 0.94, 1.0, 0.36)
}

x = { Silence 1 }

bd = {
    -- eight detuned voices around the fundamental: a wide sub pair at
    -- the bottom, a mid pair for the shell, upper partials for the
    -- knock — then a fully-dialed kick instead of the flat 909 preset
    Overlay [
        { 5/1, 0, 1/5, -1/8 },
        { 5/1, -11, 1/5, 1/8 },
        { 2/1, 1, 1/2, -3/4 },
        { 2/1, 0, 1/2, 3/4 },
        { 3/1, 0, 1/8, -1/4 },
        { 3/1, -3, 1/8, 1/4 },
        { 1/1, 0, 1, 3/4 },
        { 1/1, -4, 1, -3/4 },
    ]
    | Kick {
        body: 0.85,
        pitch_decay: 0.025,
        pitch_range: 0.3,
        amp_decay: 0.45,
        click_amount: 0.2,
        saturation: 0.85,
        hump: 4.85,
        shell: 0.4,
        ks_mix: 0.25
    }
    | Gm 1
    -- one hue family, dark to light: charcoal pressed to raw umber —
    -- thick is dark and neutral, thin lets the felt show through
    | Color [#f7f4ef, #ddd3c4, #b3a48c, #7d6c52, #4c3e2b, #221a10]
    | wgsl {
        // THE PRESS: a pip lands narrow and heavy, spreads under the
        // weight, and thins where it came away.
        Sm 0.013;
        Smx "0.32";
        Smy "2.2";
        Ry "Clock * 0.010";
        SwingZ "0.72 - 1.44 * (note_event - 2.0 * floor(note_event / 2.0))";
        Shade key;
        Vm 0.0; Die 0.77;
        Bm "(1.25 + Rand(3) * 0.8) * (0.90 + 1.40 * exp(0.0 - Time * 6.0))";
        Bm Slew(0.55, 2.2);

        // thick is dark and neutral, thin is warm
        let press = exp(0.0 - Time * 4.0);
        red   = red   * (1.55 - 0.55 * press);
        green = green * (1.22 - 0.32 * press);
        blue  = blue  * (0.90 + 0.20 * press);
    }
    | pip
    | wet
    | canvas
}

sn = {
    Snare 909 | Gm 0.7
    -- cadmium: orange at the moment of contact, toward alizarin as it
    -- spreads and thins into the ground
    | Color [#fff3ec, #ffd2b8, #f79c6a, #d95f2b, #9c3a12, #521c06]
    | wgsl {
        // THE STRIKE FLARES: it arrives longer and thicker and settles
        // back inside a few frames — Time is the mark's own age.
        Sm "0.0085 * (1.0 + 2.20 * exp(0.0 - Time * 3.0))";
        Smx "0.20 * (1.0 + 1.40 * exp(0.0 - Time * 3.5))";
        Smy "1.7 * (1.0 + 1.10 * exp(0.0 - Time * 3.0))";
        Ry "Clock * 0.010";
        SwingZ "1.02 - 2.04 * (note_event - 2.0 * floor(note_event / 2.0))";
        Vm 0.0; Die 0.77;
        Bm "(1.35 + Rand(5) * 0.85) * (0.95 + 5.50 * exp(0.0 - Time * 3.2))";
        Bm Slew(0.42, 2.6);

        // green falling carries orange to red; blue rising late is the
        // crimson coming up underneath
        let strike = exp(0.0 - Time * 3.4);
        red   = red   * (1.00 + 0.50 * strike);
        green = green * (0.55 + 1.15 * strike);
        blue  = blue  * (0.70 + 0.55 * (1.0 - strike));
    }
    | coil
    | wet
    | canvas
}

hh = {
    HiHat 909 | Gm 0.25 | Pa 1/4
    -- spark chaff: dense gold at the head, cooling through green
    | Color [#fdfbe8, #f2e79a, #d9c44e, #99a13c, #4f7340, #1e3d2a]
    | wgsl {
        // A BURST: big for an instant, then it holds as a speck. On a
        // white ground brightness buys density, not glow.
        Sm "(0.55 + Rand(21) * 0.45) * (0.9 + 1.2 * exp(0.0 - Time * 6.0))";
        Smy "0.9 + 0.3 * Rand(22)";
        Smx "0.9 + 0.3 * Rand(23)";
        Ry "Clock * 0.010";
        SwingZ "Rand(24) * 3.14159";
        Bm "0.9 + 0.8 * exp(0.0 - Time * 6.0)";
        Vm 0.0; Va "0.0 - 0.32"; Die 0.84;

        // lands dense gold, thins toward viridian as it ages
        let fresh = exp(0.0 - Time * 5.0);
        red = red * (1.0 + 0.35 * fresh);
        green = green * (0.85 + 0.25 * fresh);
        blue = blue * (0.88 + 0.20 * fresh);
    }
    | fleck
    | wet
    | canvas
}

oh = {
    OpenHat 909 | Gm 0.35 | Pa 1/4
    | Color [#fdfbe8, #f2e79a, #d9c44e, #99a13c, #4f7340, #1e3d2a]
    | wgsl {
        // the open hat is the same chaff, wider and slower to settle
        Sm "(0.85 + Rand(31) * 0.55) * (0.9 + 1.2 * exp(0.0 - Time * 4.0))";
        Smy "0.9 + 0.3 * Rand(32)";
        Smx "0.9 + 0.3 * Rand(33)";
        Ry "Clock * 0.010";
        SwingZ "Rand(34) * 3.14159";
        Bm "0.9 + 0.8 * exp(0.0 - Time * 4.0)";
        Vm 0.0; Va "0.0 - 0.32"; Die 0.84;

        let fresh = exp(0.0 - Time * 3.5);
        red = red * (1.0 + 0.35 * fresh);
        green = green * (0.85 + 0.25 * fresh);
        blue = blue * (0.88 + 0.20 * fresh);
    }
    | fleck
    | wet
    | canvas
}

cp = {
    Clap 909 | Gm 0.6
    -- the tally: violet, loaded to near-black where the stroke bites
    | Color [#f6f2fa, #d5c4e8, #a888cc, #7355a4, #47316f, #251642]
    | wgsl {
        // one fast cut — thin, hard, over in a moment
        Sm "0.0080 * (1.0 + 1.80 * exp(0.0 - Time * 4.0))";
        Smx "0.16";
        Smy "2.4";
        Ry "Clock * 0.010";
        SwingZ "0.60 - 1.20 * (note_event - 2.0 * floor(note_event / 2.0))";
        Vm 0.0; Die 0.77;
        Bm "(1.10 + Rand(41) * 0.70) * (0.95 + 3.50 * exp(0.0 - Time * 3.5))";
        Bm Slew(0.45, 2.4);

        let bite = exp(0.0 - Time * 3.8);
        red   = red   * (0.85 + 0.35 * bite);
        green = green * (0.75 + 0.30 * bite);
        blue  = blue  * (1.00 + 0.25 * bite);
    }
    | slash
    | wet
    | canvas
}

bl = {
    Tom glass | Fm 2 | Gm 0.4 | Pa -1/4
    -- cobalt through ultramarine: a ramp of HOW MUCH PAINT, wash to
    -- load — the lit shoulder is written darkest because pigment
    -- subtracts
    | Color [#f4fbff, #b9e0f2, #6bb4d8, #2f7cae, #17497e, #0a2247]
    | wgsl {
        // A BROAD FLAT BRUSH, LOADED, RUNNING DRY: the head of the
        // stroke is wet and wide, the tail is a dry liner.
        Sm 0.030;
        Smx "0.30";
        Smy "2.6";
        Ry "Clock * 0.010";
        SwingZ "0.0";
        Shade rim;
        Vm 0.0; Die 0.77;
        Bm "(0.62 + Rand(7) * 0.40) * (0.85 + 1.05 * exp(0.0 - Time * 1.8))";
        Bm Slew(0.50, 1.1);

        // wet ultramarine is deep and slightly violet; as the water
        // goes it lightens toward cerulean
        let wet = exp(0.0 - Time * 1.5);
        red   = red   * (0.72 + 0.55 * wet);
        green = green * (0.86 + 0.30 * wet);
        blue  = blue  * (0.94 + 0.22 * wet);
    }
    | orbital
    | wet
    | canvas
}

rs = {
    Rimshot 909 | Gm 0.45 | Pa -1/3
    | Color [#fff3ec, #ffd2b8, #f79c6a, #d95f2b, #9c3a12, #521c06]
    | wgsl {
        // the rim click is a dry speck of the snare's cadmium
        Sm "(0.45 + Rand(51) * 0.30) * (0.9 + 1.0 * exp(0.0 - Time * 6.0))";
        Smy "0.9 + 0.3 * Rand(52)";
        Smx "0.9 + 0.3 * Rand(53)";
        Ry "Clock * 0.010";
        SwingZ "Rand(54) * 3.14159";
        Bm "0.9 + 0.7 * exp(0.0 - Time * 6.0)";
        Vm 0.0; Die 0.84;

        let fresh = exp(0.0 - Time * 5.0);
        red = red * (1.0 + 0.30 * fresh);
        green = green * (0.80 + 0.25 * fresh);
        blue = blue * (0.85 + 0.15 * fresh);
    }
    | fleck
    | wet
    | canvas
}

anchor = {
    Seq [
        bd, x, x, bd | Gm 0.6, x, x, bd, x,
        x, x, bd | Gm 0.7, x, x, bd | Gm 0.5, x, x
    ]
}

backbeat = {
    Seq [
        x, x, x, x, cp, x, x, x,
        x, x, x, x, cp, x, x, x
    ]
}

hat_dice = {
    Choose [
        hh,
        hh | Gm 0.4,
        hh | Lm 1/2 | Repeat 2,
        hh | Lm 1/4 | Repeat 4 | Gm 0.5,
        oh | Gm 0.7,
        x
    ] | Repeat 16
}

snare_dice = {
    Choose [
        x,
        x,
        sn | Gm 0.4,
        sn | Lm 1/2 | Repeat 2 | Gm 0.5,
        sn | Fm 9/8 | Lm 1/3 | Repeat 3 | Gm 0.5,
        sn | Fm 6/5 | Lm 1/4 | Repeat 4 | Gm 0.6,
        sn | Bitcrusher(4, 1, 0.7) | Gm 0.5,
        sn | Overdrive(4, 0.4) | Lm 1/2 | Repeat 2 | Gm 0.5,
        rs | Gm 0.8
    ] | Repeat 16
}

blip_dice = {
    Choose [
        x,
        x,
        x,
        bl,
        bl | Fm 9/8,
        bl | Fm 5/4 | Bitcrusher(5, 2, 0.8),
    --    bl | Fm 3/2 | Wavefolder(0.25, 6, 2, 0.4),
     --   bl | Fm 5/3 | Lm 1/2 | Repeat 2
    ] 
| Overlay [
    {1/1, 3, 1, 1},
    {1/1, 0, 1, -1},
    {1/2, -4, 1, 1/2},
    {1/2, 0, 1, -1/2},
]
    | Repeat 16
}

lock = { Overlay [anchor, backbeat, hat_dice] }

full = { Overlay [anchor, backbeat, hat_dice, snare_dice, blip_dice] }

free = { Overlay [hat_dice, snare_dice, blip_dice] }

main = {
    Seq [
        --   anchor,
        lock | Reverse | Fm 3/2,
        lock | Fm 7/4,
        full,
        full,
        full,
        free,
        free | Fm 6/5,
        full,
        full | Fm 6/5,
        full,
       -- Overlay [bd | Lm 6, cp | Lm 6, oh | Lm 6]
    ]
    | Repeat 3
} -> [bd, sn, hh, bl]
