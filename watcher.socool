{ f: 311.127, l: 1, g: 1/3, p: 0 }

thing1 = {
    Overlay [
        { 3/2, 2, 1, 1 },
        { 3/2, 0, 1, -1 },
        { 1/2, 0, 1, -1 },
        { 1/2, 0, 1, -1 },
    ]
    | Seq [
        Fm 1, Fm 9/8, Fm 5/4 | Lm 2
    ]
    | Color [lipstickred, white, grey, black, black, black] | Gradient(1, 1, 0)
    | wgsl {
        Seq [
            Direction (0, 0, -1) | Bend (0, 1, 0, 0.2) | Lm 32;
        ];
    }
}

thing2 = {
    Overlay [
        { 1/1, 3, 1, 1 },
        { 1/1, 0, 1, -1 },
    ]
    | Seq [
        Fm 3/4 | Lm 4, Fm 2/3 | Lm 2, Fm 1/4 | Lm 2,
        Fm 3/4 | Lm 4, Fm 5/6, Fm 15/16, Fm 1,
        Seq [Fm 9/8, Fm 5/4, Fm 3/2, Fm 15/8] | Lm 2/3,
    ]
    | Seq [Fm 1, Fm 5/4, Fm 8/5]
    | FitLength thing1
    | Color [deeporange, white, black, black, black] | Gradient(-1, 1, 0)
    | wgsl {
        Seq [
            Direction (0, -0.2, -1)
            | Lm 8
            | Bend (0, -1, 0, 0.2);
            Direction (0, -0.2, -1)
            | Lm 8
            | Bend (0, 1, 0, 1.0);
        ];
    }
}

main = {
    Overlay [
        thing1,
        thing2
    ]
    | Seq [
        Fm 1,
        -- Reverse | Lm 1/2,
        -- Fm 9/8 | ModBy [Fm 1, Fm 3/4],
    ]
    | wgsl {
        Xm 0.75;
        Xa "sin(time) * 0.05";
        Sm 1.9;
        -- Sm "1 + scale + sin(time * 4) * 0.2 + 0.8";
        Vm 1/5;
        Xa "(x * time * 0.5)";
        Xm 0.3;
        Rz "sin(time * 0.1) * 0.2" | Lm 32;
        -- Ry 3.0;
    }
    | Seq [Fm 1, Reverse, Fm 9/8, Fm 0 | Lm 1/3]
    | Repeat 8
}
